#!/usr/bin/env bash
set -euo pipefail

: "${CONFIG_ROOT:=/config}"
: "${DSH_HOME:=${CONFIG_ROOT}/.dsh}"
: "${DSH_BIN:=${CONFIG_ROOT}/.npm-global/bin/dsh}"
: "${DSH_WORKSPACE:=${CONFIG_ROOT}/Workspace}"
: "${DSH_AGENT_WORKSPACE_MCP_PATCH:=${DSH_HOME}/agent-workspace-mcp.cordis.yml}"
: "${DEEPSEEK_HARNESS_ROOT:=${CONFIG_ROOT}/opt/deepseek-harness}"
: "${NODE_BIN:=${CONFIG_ROOT}/node/bin/node}"

export HOME="${CONFIG_ROOT}"
export DSH_HOME

if [[ ! -x "$DSH_BIN" ]]; then
  echo "DeepSeek Harness runtime is unavailable: $DSH_BIN" >&2
  exit 1
fi

patch_args=()
if [[ -s "$DSH_AGENT_WORKSPACE_MCP_PATCH" ]]; then
  patch_args=(--patch "$DSH_AGENT_WORKSPACE_MCP_PATCH")
fi

case "${1:-}" in
  web)
    shift
    cd "$DSH_WORKSPACE"
    exec "$NODE_BIN" \
      "$DEEPSEEK_HARNESS_ROOT/lib/deepseek-harness-web-proxy.mjs" \
      "${patch_args[@]}" "$@"
    ;;
  headless)
    shift
    exec "$DSH_BIN" --profile headless "${patch_args[@]}" "$@"
    ;;
  *)
    exec "$DSH_BIN" "$@"
    ;;
esac
