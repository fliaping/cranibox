#!/usr/bin/env python3
"""MCP stdio adapter for Cranibox desktop Computer Use."""

from __future__ import annotations

import base64
import json
import os
from pathlib import Path
import sys
import urllib.error
import urllib.request
from typing import Any


def bridge_url() -> str:
    port_file = Path(os.environ.get('AGENT_WORKSPACE_CONFIG_ROOT', '/config')) / '.config/agent-workspace/desktop-bridge-port'
    port = int(os.environ.get('AGENT_DESKTOP_BRIDGE_PORT') or (port_file.read_text().strip() if port_file.exists() else '8765'))
    if not 1 <= port <= 65535:
        raise ValueError('desktop bridge port must be between 1 and 65535')
    return os.environ.get('AGENT_DESKTOP_BRIDGE_URL', f'http://127.0.0.1:{port}')
SESSION = f"mcp-{os.getpid()}"


def schema(properties: dict[str, Any] | None = None, required: list[str] | None = None) -> dict[str, Any]:
    value: dict[str, Any] = {"type": "object", "properties": properties or {}, "additionalProperties": False}
    if required:
        value["required"] = required
    return value


COORD = {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2, "description": "[x,y] pixels, or 0..1 values when coordinate_space is normalized."}
SPACE = {"type": "string", "enum": ["pixels", "normalized"], "default": "pixels"}
TOOLS = [
    {"name": "desktop_status", "description": "Inspect desktop Computer Use readiness, resolution, pause state, sessions, and security boundary.", "inputSchema": schema()},
    {"name": "desktop_screenshot", "description": "Capture the current user-visible Selkies desktop as a PNG. Use managed browser CDP instead for normal web tasks.", "inputSchema": schema({"region": {"type": "array", "items": {"type": "number"}, "minItems": 4, "maxItems": 4, "description": "Optional [left,top,right,bottom] crop."}, "coordinate_space": SPACE})},
    {"name": "desktop_cursor_position", "description": "Get the current desktop cursor position.", "inputSchema": schema()},
    {"name": "desktop_list_windows", "description": "List visible XWayland windows and report enumeration completeness.", "inputSchema": schema()},
    {"name": "desktop_focus_window", "description": "Focus a window by a visible coordinate, exact Wayland app_id/title when supported, or a listed XWayland window_id. Screenshot plus coordinate is the reliable universal path.", "inputSchema": schema({"coordinate": COORD, "coordinate_space": SPACE, "title": {"type": "string"}, "app_id": {"type": "string"}, "window_id": {"type": "string"}})},
    {"name": "desktop_move", "description": "Move the pointer to a desktop coordinate.", "inputSchema": schema({"coordinate": COORD, "coordinate_space": SPACE}, ["coordinate"])},
    {"name": "desktop_click", "description": "Click at an optional coordinate.", "inputSchema": schema({"button": {"type": "string", "enum": ["left", "right", "middle"]}, "count": {"type": "integer", "minimum": 1, "maximum": 3}, "coordinate": COORD, "coordinate_space": SPACE, "modifier": {"type": "string"}})},
    {"name": "desktop_drag", "description": "Drag with the left mouse button between two coordinates.", "inputSchema": schema({"start_coordinate": COORD, "coordinate": COORD, "coordinate_space": SPACE}, ["start_coordinate", "coordinate"])},
    {"name": "desktop_scroll", "description": "Scroll vertically or horizontally, optionally at a coordinate.", "inputSchema": schema({"direction": {"type": "string", "enum": ["up", "down", "left", "right"]}, "amount": {"type": "integer", "minimum": 1, "maximum": 100}, "coordinate": COORD, "coordinate_space": SPACE, "modifier": {"type": "string"}}, ["direction", "amount"])},
    {"name": "desktop_type", "description": "Type text into the focused native desktop application.", "inputSchema": schema({"text": {"type": "string", "maxLength": 100000}}, ["text"])},
    {"name": "desktop_key", "description": "Press one key or a + separated combination such as ctrl+s.", "inputSchema": schema({"key": {"type": "string"}}, ["key"])},
    {"name": "desktop_emergency_stop", "description": "Immediately pause all subsequent desktop input actions until explicitly resumed.", "inputSchema": schema({"reason": {"type": "string"}})},
    {"name": "desktop_resume", "description": "Resume desktop input after an emergency stop. Call only with explicit user intent.", "inputSchema": schema()},
]


def bridge_action(payload: dict[str, Any]) -> dict[str, Any]:
    request = urllib.request.Request(f"{bridge_url()}/v1/action", data=json.dumps(payload).encode("utf-8"), headers={"Content-Type": "application/json", "X-Agent-Session": SESSION}, method="POST")
    try:
        with urllib.request.urlopen(request, timeout=40) as response:
            return json.loads(response.read().decode("utf-8"))
    except urllib.error.HTTPError as exc:
        try: detail = json.loads(exc.read().decode("utf-8")).get("error", str(exc))
        except Exception: detail = str(exc)
        raise RuntimeError(detail) from exc
    except (OSError, urllib.error.URLError, json.JSONDecodeError) as exc:
        raise RuntimeError(f"agent-desktop-bridge is unavailable: {exc}") from exc


def translate(name: str, args: dict[str, Any]) -> dict[str, Any]:
    if name == "desktop_status": return {"action": "status"}
    if name == "desktop_screenshot": return ({"action": "zoom", **args} if args.get("region") else {"action": "screenshot", **({"coordinate_space": args["coordinate_space"]} if "coordinate_space" in args else {})})
    if name == "desktop_cursor_position": return {"action": "cursor_position"}
    if name == "desktop_list_windows": return {"action": "window_list"}
    if name == "desktop_focus_window": return {"action": "window_focus", **args}
    if name == "desktop_move": return {"action": "mouse_move", **args}
    if name == "desktop_drag": return {"action": "left_click_drag", **args}
    if name == "desktop_type": return {"action": "type", **args}
    if name == "desktop_key": return {"action": "key", "text": args["key"]}
    if name == "desktop_scroll":
        return {"action": "scroll", "scroll_direction": args["direction"], "scroll_amount": args["amount"], **({"coordinate": args["coordinate"]} if "coordinate" in args else {}), **({"coordinate_space": args["coordinate_space"]} if "coordinate_space" in args else {}), **({"text": args["modifier"]} if args.get("modifier") else {})}
    if name == "desktop_click":
        button, count = args.get("button", "left"), args.get("count", 1)
        action = f"{button}_click"
        if button == "left" and count in (2, 3): action = "double_click" if count == 2 else "triple_click"
        return {"action": action, **({"coordinate": args["coordinate"]} if "coordinate" in args else {}), **({"coordinate_space": args["coordinate_space"]} if "coordinate_space" in args else {}), **({"text": args["modifier"]} if args.get("modifier") else {})}
    if name == "desktop_emergency_stop": return {"action": "emergency_stop", **args}
    if name == "desktop_resume": return {"action": "resume"}
    raise RuntimeError(f"unknown tool: {name}")


def tool_result(name: str, args: dict[str, Any]) -> dict[str, Any]:
    value = bridge_action(translate(name, args))
    data = value.get("data")
    if name == "desktop_screenshot" and isinstance(data, str):
        base64.b64decode(data, validate=True)
        return {"content": [{"type": "image", "data": data, "mimeType": "image/png"}, {"type": "text", "text": "Captured the current user-visible desktop. Coordinates use framebuffer pixels."}]}
    return {"content": [{"type": "text", "text": json.dumps(value, ensure_ascii=False, indent=2)}]}


def respond(request: dict[str, Any]) -> dict[str, Any] | None:
    method = request.get("method")
    if method and method.startswith("notifications/"): return None
    request_id = request.get("id")
    try:
        if method == "initialize":
            requested = str((request.get("params") or {}).get("protocolVersion", "2024-11-05"))
            protocol = requested if requested in {"2024-11-05", "2025-03-26", "2025-06-18"} else "2024-11-05"
            result = {"protocolVersion": protocol, "capabilities": {"tools": {"listChanged": False}}, "serverInfo": {"name": "agent-desktop", "version": "1.0.0"}}
        elif method == "ping": result = {}
        elif method == "tools/list": result = {"tools": TOOLS}
        elif method == "tools/call":
            params = request.get("params") or {}
            result = tool_result(str(params.get("name", "")), params.get("arguments") or {})
        else: return {"jsonrpc": "2.0", "id": request_id, "error": {"code": -32601, "message": f"Method not found: {method}"}}
        return {"jsonrpc": "2.0", "id": request_id, "result": result}
    except Exception as exc:
        return {"jsonrpc": "2.0", "id": request_id, "result": {"content": [{"type": "text", "text": str(exc)}], "isError": True}}


def main() -> None:
    for line in sys.stdin:
        try:
            response = respond(json.loads(line))
            if response is not None: print(json.dumps(response, ensure_ascii=False), flush=True)
        except Exception as exc:
            print(json.dumps({"jsonrpc": "2.0", "id": None, "error": {"code": -32700, "message": str(exc)}}), flush=True)


if __name__ == "__main__": main()
