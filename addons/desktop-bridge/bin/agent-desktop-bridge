#!/usr/bin/env python3
"""Loopback-only safety and compatibility layer for desktop Computer Use."""

from __future__ import annotations

import argparse
import base64
import json
import os
import pathlib
import shutil
import socket
import subprocess
import tempfile
import threading
import time
import urllib.error
import urllib.request
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from typing import Any


HOST = os.environ.get("AGENT_DESKTOP_BRIDGE_HOST", "127.0.0.1")
PORT_FILE = pathlib.Path(os.environ.get('AGENT_WORKSPACE_CONFIG_ROOT', '/config')) / '.config/agent-workspace/desktop-bridge-port'
PORT = int(os.environ.get('AGENT_DESKTOP_BRIDGE_PORT') or (PORT_FILE.read_text().strip() if PORT_FILE.exists() else '8765'))
if not 1 <= PORT <= 65535:
    raise ValueError('desktop bridge port must be between 1 and 65535')
NATIVE_PORT = int(os.environ.get("PIXELFLUX_CU", "8764"))
NATIVE_URL = os.environ.get("AGENT_DESKTOP_NATIVE_URL", f"http://127.0.0.1:{NATIVE_PORT}/computer-use")
STATE_DIR = pathlib.Path(os.environ.get("AGENT_DESKTOP_STATE_DIR", "/config/.local/state/agent-desktop-bridge"))
STATE_FILE = STATE_DIR / "state.json"
MUTATING_ACTIONS = {
    "mouse_move", "left_click", "right_click", "middle_click", "double_click",
    "triple_click", "left_click_drag", "left_mouse_down", "left_mouse_up",
    "type", "key", "hold_key", "scroll", "window_focus",
}
NATIVE_ACTIONS = MUTATING_ACTIONS - {"window_focus"} | {"screenshot", "zoom", "cursor_position", "wait"}
SESSION_TTL = 300
_lock = threading.RLock()
_sessions: dict[str, dict[str, Any]] = {}
_screen = {"width": 0, "height": 0}


def atomic_json(path: pathlib.Path, value: dict[str, Any]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            json.dump(value, handle, ensure_ascii=False, indent=2)
            handle.write("\n")
        os.chmod(temporary, 0o600)
        os.replace(temporary, path)
    finally:
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass


def load_state() -> dict[str, Any]:
    try:
        value = json.loads(STATE_FILE.read_text(encoding="utf-8"))
        if isinstance(value, dict):
            return value
    except (OSError, json.JSONDecodeError):
        pass
    return {"paused": False, "reason": "", "changed_at": ""}


def set_paused(paused: bool, reason: str) -> dict[str, Any]:
    value = {"paused": paused, "reason": reason if paused else "", "changed_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())}
    with _lock:
        atomic_json(STATE_FILE, value)
    return value


def native_action(payload: dict[str, Any], timeout: float = 30) -> dict[str, Any]:
    request = urllib.request.Request(NATIVE_URL, data=json.dumps(payload).encode("utf-8"), headers={"Content-Type": "application/json"}, method="POST")
    try:
        with urllib.request.urlopen(request, timeout=timeout) as response:
            value = json.loads(response.read().decode("utf-8"))
    except (OSError, urllib.error.URLError, json.JSONDecodeError) as exc:
        raise RuntimeError(f"Selkies Computer Use backend is unavailable: {exc}") from exc
    if not isinstance(value, dict):
        raise RuntimeError("Selkies Computer Use backend returned an invalid response")
    data = value.get("data")
    if isinstance(data, str) and payload.get("action") == "screenshot":
        try:
            png = base64.b64decode(data, validate=True)
            if len(png) >= 24 and png.startswith(b"\x89PNG\r\n\x1a\n"):
                with _lock:
                    _screen["width"] = int.from_bytes(png[16:20], "big")
                    _screen["height"] = int.from_bytes(png[20:24], "big")
        except (ValueError, TypeError):
            pass
    return value


def backend_available() -> bool:
    try:
        with socket.create_connection(("127.0.0.1", NATIVE_PORT), timeout=0.15):
            return True
    except OSError:
        return False


def process_envs(names: set[str], proc_root: pathlib.Path = pathlib.Path('/proc')) -> list[tuple[str, dict[str, str]]]:
    results = []
    for entry in proc_root.iterdir():
        if not entry.name.isdigit():
            continue
        try:
            name = (entry / 'comm').read_text().strip()
            if name not in names:
                continue
            values = {}
            for raw in (entry / 'environ').read_bytes().split(b'\0'):
                key, separator, value = raw.partition(b'=')
                if separator and key in {b'XDG_RUNTIME_DIR', b'WAYLAND_DISPLAY', b'DISPLAY', b'DBUS_SESSION_BUS_ADDRESS', b'PIXELFLUX_CU'}:
                    values[key.decode()] = value.decode(errors='replace')
            results.append((name, values))
        except OSError:
            continue
    return results


def backend_diagnostic() -> dict[str, Any]:
    processes = process_envs({'selkies'})
    if not processes:
        return {'reason': 'selkies-not-running', 'restart_required': False}
    ports = [values.get('PIXELFLUX_CU', '') for _, values in processes]
    if str(NATIVE_PORT) in ports:
        return {'reason': 'native-backend-not-listening', 'restart_required': False,
                'detail': 'Selkies has the expected port setting; inspect its startup logs.'}
    return {
        'reason': 'native-backend-disabled' if all(not p or p == '0' for p in ports) else 'native-backend-port-mismatch',
        'restart_required': True,
        'expected_port': NATIVE_PORT,
        'detail': 'The running Selkies process did not inherit the required PIXELFLUX_CU port. Save desktop work before restarting Selkies; restarting the bridge alone cannot enable it.',
    }


def desktop_env() -> dict[str, str]:
    env = os.environ.copy()
    env.setdefault("HOME", "/config")
    priorities = {'plasmashell': 0, 'labwc': 1, 'kwin_wayland': 2}
    sessions = sorted(process_envs(set(priorities)), key=lambda item: priorities[item[0]])
    if sessions:
        env.update({k: v for k, v in sessions[0][1].items() if k != 'PIXELFLUX_CU'})
    env.setdefault("XDG_RUNTIME_DIR", "/config/.XDG")
    env.setdefault("WAYLAND_DISPLAY", "wayland-1")
    env.setdefault("DISPLAY", ":1")
    return env


def run_window_command(args: list[str]) -> subprocess.CompletedProcess[str]:
    try:
        return subprocess.run(args, check=False, capture_output=True, text=True, timeout=5, env=desktop_env())
    except (FileNotFoundError, subprocess.TimeoutExpired) as exc:
        return subprocess.CompletedProcess(args, 127, "", str(exc))


def list_windows() -> dict[str, Any]:
    """List XWayland windows and report the Wayland visibility boundary."""
    windows: list[dict[str, Any]] = []
    if shutil.which("xdotool"):
        result = run_window_command(["xdotool", "search", "--onlyvisible", "--name", ".*"])
        for raw_id in result.stdout.splitlines():
            if not raw_id.isdigit():
                continue
            title = run_window_command(["xdotool", "getwindowname", raw_id]).stdout.strip()
            if title:
                windows.append({"id": raw_id, "title": title, "backend": "xwayland"})
    return {"result": "ok", "windows": windows, "backend": "wayland+xwayland", "complete": False, "note": "Enumeration is limited to visible XWayland windows. Use screenshot plus coordinate focus for native Wayland windows; title/app-id focus is available only when the compositor exposes foreign-toplevel."}


def focus_window(payload: dict[str, Any]) -> dict[str, Any]:
    title = str(payload.get("title", "")).strip()
    app_id = str(payload.get("app_id", "")).strip()
    window_id = str(payload.get("window_id", "")).strip()
    coordinate = payload.get("coordinate")
    if isinstance(coordinate, list) and len(coordinate) == 2 and all(isinstance(value, int) for value in coordinate):
        result = native_action({"action": "left_click", "coordinate": coordinate})
        return {**result, "backend": "visual-coordinate", "coordinate": coordinate}
    if not any((title, app_id, window_id)):
        raise ValueError("coordinate, title, app_id, or window_id is required")
    if window_id and window_id.isdigit() and shutil.which("xdotool"):
        result = run_window_command(["xdotool", "windowactivate", "--sync", window_id])
        if result.returncode == 0:
            return {"result": "ok", "backend": "xwayland", "window_id": window_id}
    if shutil.which("wlrctl"):
        args = ["wlrctl", "toplevel", "focus"]
        if app_id:
            args.append(f"app_id:{app_id}")
        if title:
            args.append(f"title:{title}")
        result = run_window_command(args)
        if result.returncode == 0:
            return {"result": "ok", "backend": "wayland", "title": title, "app_id": app_id}
        raise RuntimeError(result.stderr.strip() or "no matching Wayland window")
    raise RuntimeError("window focus requires wlrctl for Wayland or a listed XWayland window id")


def record_session(session: str, action: str) -> None:
    if not session:
        return
    now = time.time()
    with _lock:
        _sessions[session[:80]] = {"id": session[:80], "last_action": action, "last_seen": now}
        for key in [key for key, item in _sessions.items() if now - item["last_seen"] > SESSION_TTL]:
            _sessions.pop(key, None)


def status() -> dict[str, Any]:
    state = load_state()
    now = time.time()
    available = backend_available()
    with _lock:
        sessions = [{"id": item["id"], "last_action": item["last_action"], "idle_seconds": round(now - item["last_seen"], 1)} for item in _sessions.values() if now - item["last_seen"] <= SESSION_TTL]
        width, height = _screen["width"], _screen["height"]
    return {
        "service": "agent-desktop-bridge", "state": "paused" if state.get("paused") else "ready" if available else "backend-unavailable",
        "paused": bool(state.get("paused")), "pause_reason": state.get("reason", ""), "backend_available": available,
        "backend_diagnostic": {} if available else backend_diagnostic(),
        "backend": "selkies-pixelflux-wayland", "bridge_url": f"http://{HOST}:{PORT}", "native_url": f"http://127.0.0.1:{NATIVE_PORT}",
        "native_bind": f"0.0.0.0:{NATIVE_PORT}", "native_security": "internal upstream; never publish this port",
        "loopback_only": HOST in {"127.0.0.1", "localhost", "::1"}, "display": {"wayland": desktop_env()["WAYLAND_DISPLAY"], "x11": desktop_env()["DISPLAY"]},
        "resolution": {"width": width, "height": height}, "active_sessions": sessions,
        "capabilities": ["screenshot", "zoom", "cursor_position", "mouse_move", "click", "drag", "scroll", "key", "type", "window_list", "window_focus", "emergency_stop"],
        "coordinate_spaces": ["pixels", "normalized"],
        "browser_policy": "Use managed Chromium CDP for web tasks; use desktop Computer Use for native applications.",
    }


def prime_screen() -> None:
    try:
        native_action({"action": "screenshot"})
    except RuntimeError as exc:
        print(f"desktop backend probe failed: {exc}", flush=True)


def normalize_payload(payload: dict[str, Any]) -> dict[str, Any]:
    value = dict(payload)
    space = str(value.pop("coordinate_space", "pixels"))
    if space == "pixels":
        for key, expected in (("coordinate", 2), ("start_coordinate", 2), ("region", 4)):
            coordinate = value.get(key)
            if coordinate is None:
                continue
            if not isinstance(coordinate, list) or len(coordinate) != expected or not all(isinstance(item, (int, float)) for item in coordinate):
                raise ValueError(f"{key} must contain {expected} numeric pixel values")
            value[key] = [round(item) for item in coordinate]
        return value
    if space != "normalized":
        raise ValueError("coordinate_space must be pixels or normalized")
    with _lock:
        width, height = _screen["width"], _screen["height"]
    if not width or not height:
        native_action({"action": "screenshot"})
        with _lock:
            width, height = _screen["width"], _screen["height"]
    if not width or not height:
        raise RuntimeError("screen resolution is unavailable")
    for key in ("coordinate", "start_coordinate"):
        coordinate = value.get(key)
        if coordinate is None:
            continue
        if not isinstance(coordinate, list) or len(coordinate) != 2 or not all(isinstance(item, (int, float)) and 0 <= item <= 1 for item in coordinate):
            raise ValueError(f"{key} must contain two normalized values between 0 and 1")
        value[key] = [round(coordinate[0] * (width - 1)), round(coordinate[1] * (height - 1))]
    region = value.get("region")
    if region is not None:
        if not isinstance(region, list) or len(region) != 4 or not all(isinstance(item, (int, float)) and 0 <= item <= 1 for item in region):
            raise ValueError("region must contain four normalized values between 0 and 1")
        value["region"] = [round(region[0] * width), round(region[1] * height), round(region[2] * width), round(region[3] * height)]
    return value


def execute(payload: dict[str, Any], session: str) -> dict[str, Any]:
    payload = normalize_payload(payload)
    action = str(payload.get("action", "")).strip()
    if action == "status":
        record_session(session, action)
        return status()
    if action == "emergency_stop":
        record_session(session, action)
        return {"result": "ok", **set_paused(True, str(payload.get("reason", "emergency stop")))}
    if action == "resume":
        record_session(session, action)
        return {"result": "ok", **set_paused(False, "")}
    if action in MUTATING_ACTIONS and load_state().get("paused"):
        raise PermissionError("desktop control is paused; resume it explicitly before sending input")
    record_session(session, action)
    if action == "window_list": return list_windows()
    if action == "window_focus": return focus_window(payload)
    if action not in NATIVE_ACTIONS: raise ValueError(f"unsupported desktop action: {action}")
    return native_action(payload)


class Handler(BaseHTTPRequestHandler):
    server_version = "AgentDesktopBridge/1"
    def log_message(self, fmt: str, *args: Any) -> None:
        print(f"[{time.strftime('%Y-%m-%d %H:%M:%S')}] {fmt % args}", flush=True)
    def send_json(self, code: int, value: dict[str, Any]) -> None:
        body = json.dumps(value, ensure_ascii=False).encode("utf-8")
        self.send_response(code); self.send_header("Content-Type", "application/json; charset=utf-8"); self.send_header("Content-Length", str(len(body))); self.send_header("Cache-Control", "no-store"); self.end_headers(); self.wfile.write(body)
    def do_GET(self) -> None:  # noqa: N802
        if self.path not in {"/health", "/v1/status"}: self.send_json(404, {"error": "not found"}); return
        value = status()
        # Status remains readable during a backend outage; /health is readiness.
        self.send_json(503 if self.path == '/health' and not value['backend_available'] else 200, value)
    def do_POST(self) -> None:  # noqa: N802
        if self.path != "/v1/action": self.send_json(404, {"error": "not found"}); return
        try:
            length = int(self.headers.get("Content-Length", "0"))
            if length <= 0 or length > 2 * 1024 * 1024: raise ValueError("request body must be between 1 byte and 2 MiB")
            value = json.loads(self.rfile.read(length).decode("utf-8"))
            if not isinstance(value, dict): raise ValueError("JSON object required")
            self.send_json(200, execute(value, self.headers.get("X-Agent-Session", "http-client")))
        except PermissionError as exc: self.send_json(423, {"error": str(exc), "paused": True})
        except ValueError as exc: self.send_json(400, {"error": str(exc)})
        except RuntimeError as exc: self.send_json(503, {"error": str(exc)})
        except (json.JSONDecodeError, UnicodeDecodeError) as exc: self.send_json(400, {"error": f"invalid JSON: {exc}"})


def serve() -> None:
    if HOST not in {"127.0.0.1", "localhost", "::1"}: raise SystemExit("agent-desktop-bridge refuses to bind outside loopback")
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    server = ThreadingHTTPServer((HOST, PORT), Handler)
    print(f"agent-desktop-bridge listening on http://{HOST}:{PORT}", flush=True)
    threading.Thread(target=prime_screen, daemon=True).start()
    server.serve_forever()


def client_action(action: str) -> dict[str, Any]:
    request = urllib.request.Request(f"http://127.0.0.1:{PORT}/v1/action", data=json.dumps({"action": action}).encode(), headers={"Content-Type": "application/json", "X-Agent-Session": "workspacectl"}, method="POST")
    with urllib.request.urlopen(request, timeout=35) as response: return json.loads(response.read())


def main() -> int:
    parser = argparse.ArgumentParser(description="Cranibox desktop Computer Use bridge")
    parser.add_argument("command", nargs="?", default="status", choices=("serve", "status", "screenshot", "pause", "resume")); parser.add_argument("--output"); args = parser.parse_args()
    if args.command == "serve": serve(); return 0
    if args.command == "status":
        try:
            with urllib.request.urlopen(f"http://127.0.0.1:{PORT}/v1/status", timeout=2) as response: print(json.dumps(json.loads(response.read()), ensure_ascii=False, indent=2))
        except (OSError, urllib.error.URLError) as exc: print(json.dumps({"state": "stopped", "error": str(exc)}, ensure_ascii=False, indent=2)); return 1
        return 0
    action = {"pause": "emergency_stop", "resume": "resume", "screenshot": "screenshot"}[args.command]; value = client_action(action)
    if args.command == "screenshot" and args.output: pathlib.Path(args.output).write_bytes(base64.b64decode(value["data"])); print(args.output)
    else: print(json.dumps(value, ensure_ascii=False, indent=2))
    return 0


if __name__ == "__main__": raise SystemExit(main())
