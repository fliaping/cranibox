{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cranibox",
  "mainBinaryName": "cranibox",
  "version": "1.1.0",
  "identifier": "com.cranibox.node",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5174",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Cranibox", "width": 1180, "height": 780, "minWidth": 400, "minHeight": 560, "visible": false }],
    "security": { "csp": "default-src 'self'; frame-src 'self' http://127.0.0.1:3080; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; script-src 'self'" }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "A tray resident remote node for Cranibox Agents",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": { "nsis": { "installerHooks": "windows/hooks.nsh" } },
    "macOS": {
      "dmg": {
        "background": "dmg/background.generated.tiff",
        "windowSize": { "width": 660, "height": 460 },
        "appPosition": { "x": 170, "y": 180 },
        "applicationFolderPosition": { "x": 490, "y": 180 }
      }
    }
  }
}
