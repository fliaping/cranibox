{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cranibox Node",
  "version": "0.1.0",
  "identifier": "com.cranibox.node",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5174",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Cranibox Node", "width": 880, "height": 720, "minWidth": 440, "minHeight": 560, "visible": false }],
    "security": { "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; script-src 'self'" }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "A tray resident remote node for Cranibox Agents",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
