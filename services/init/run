#!/usr/bin/with-contenv bash
echo "[init] Starting initialization..."

# ============================================================
# Homebrew persistence
# Homebrew persists under /config/.linuxbrew. The image may contain a build-time
# copy under /home/linuxbrew/.linuxbrew; on first boot, migrate it to /config and
# keep /home/linuxbrew/.linuxbrew only as a compatibility symlink.
# ============================================================
if [ -d /config/.linuxbrew ]; then
    rm -rf /home/linuxbrew/.linuxbrew
    mkdir -p /home/linuxbrew
    ln -sf /config/.linuxbrew /home/linuxbrew/.linuxbrew
    echo "[init] Homebrew persistence OK: /config/.linuxbrew"
elif [ -d /home/linuxbrew/.linuxbrew ] && [ ! -L /home/linuxbrew/.linuxbrew ]; then
    if [ ! -d /config/.linuxbrew ]; then
        # First run: copy built-in Homebrew to persistent volume
        echo "[init] Copying Homebrew to /config/.linuxbrew (first run)..."
        cp -a /home/linuxbrew/.linuxbrew /config/.linuxbrew
    fi
    # Replace real dir with symlink
    rm -rf /home/linuxbrew/.linuxbrew
    ln -sf /config/.linuxbrew /home/linuxbrew/.linuxbrew
    echo "[init] Homebrew symlinked: /home/linuxbrew/.linuxbrew -> /config/.linuxbrew"
else
    echo "[init] Homebrew not found, skipping persistence"
fi

# Ensure correct ownership
chown -R abc:abc /config/.linuxbrew 2>/dev/null || true
chown -h abc:abc /home/linuxbrew/.linuxbrew 2>/dev/null || true

# Seed concise container instructions shared by every installed Agent.
# Never overwrite user-maintained project instructions.
context_source="/usr/local/share/agent-workspace/context"
workspace_root="/config/Workspace"
mkdir -p "$workspace_root"
if [ -f "$context_source/AGENTS.md" ] && [ ! -e "$workspace_root/AGENTS.md" ]; then
    cp "$context_source/AGENTS.md" "$workspace_root/AGENTS.md"
fi
if [ -f "$context_source/CLAUDE.md" ] && [ ! -e "$workspace_root/CLAUDE.md" ]; then
    cp "$context_source/CLAUDE.md" "$workspace_root/CLAUDE.md"
fi
chown abc:abc "$workspace_root" "$workspace_root/AGENTS.md" \
    "$workspace_root/CLAUDE.md" 2>/dev/null || true

# ============================================================
# China mirror configuration
# ============================================================
if [ "$USE_CHINA_MIRROR" = "true" ]; then
    echo "[init] Configuring China mirrors..."
    /usr/local/bin/setup-mirror.sh
else
    echo "[init] Using default mirrors"
fi

# Built-in Rust control plane is available on the first boot, without capability installation.
echo "[init] Preparing Workspace core services..."
if ! s6-setuidgid abc /usr/local/bin/bootstrap-workspace-core.sh; then
    echo "[init] Failed to prepare Workspace core services" >&2
    exit 1
fi

echo "[init] Initialization complete!"
