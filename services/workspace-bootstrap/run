#!/usr/bin/with-contenv bash
set -u

target="${AGENT_WORKSPACE_BOOTSTRAP:-}"
agent="${AGENT_WORKSPACE_AGENT:-none}"
state_dir="/config/.local/state/agent-workspace"
marker="${state_dir}/bootstrap-${target}.complete"
agent_marker="${state_dir}/agent-${agent}.complete"

# Staged by tailscale-authkey-init.sh when TAILSCALE_AUTHKEY / TS_AUTHKEY /
# TAILSCALE_AUTHKEY_FILE is set; removed again after the login attempt.
tailscale_key_file="/run/agent-workspace/tailscale-authkey"

run_manager() {
  s6-setuidgid abc env HOME=/config agent-workspace-manager "$@"
}

tailscale_autoconnect() {
  [[ -s "$tailscale_key_file" ]] || return 0
  local attempt
  for attempt in 1 2 3; do
    if { [[ -x /config/opt/tailscale/libexec/tailscale ]] || run_manager install tailscale; } \
      && s6-setuidgid abc env HOME=/config TAILSCALE_AUTHKEY_FILE="$tailscale_key_file" \
        TAILSCALE_WAIT_SECONDS=90 workspacectl tailscale autoconnect; then
      break
    fi
    echo "[workspace-bootstrap] tailscale auto-login failed (attempt ${attempt}/3)"
    if [[ "$attempt" -lt 3 ]]; then
      sleep 30
    fi
  done
  rm -f -- "$tailscale_key_file"
}

if [[ -z "$target" || "$target" == "none" ]]; then
  if [[ -s "$tailscale_key_file" ]]; then
    mkdir -p "$state_dir"
    chown abc:abc /config/.local /config/.local/state "$state_dir" 2>/dev/null || true
    if [[ ! -x /config/opt/tailscale/libexec/tailscale ]]; then
      run_manager update || echo "[workspace-bootstrap] source update failed; Tailscale auto-login may fail"
    fi
    tailscale_autoconnect
  fi
  exec sleep infinity
fi

case "$target" in
  remote|foundation|base) ;;
  *)
    echo "[workspace-bootstrap] unsupported automatic target: $target" >&2
    exec sleep infinity
    ;;
esac

mkdir -p "$state_dir"
# mkdir -p runs as root here; keep every level writable for the abc-run installers.
chown abc:abc /config/.local /config/.local/state "$state_dir" 2>/dev/null || true

if [[ ! -f "$marker" ]]; then
  until run_manager update; do
    echo "[workspace-bootstrap] source update failed; retrying in 30 seconds"
    sleep 30
  done

  until run_manager install "$target"; do
    echo "[workspace-bootstrap] ${target} install failed; retrying in 30 seconds"
    sleep 30
  done

  touch "$marker"
  chown abc:abc "$marker" 2>/dev/null || true
  echo "[workspace-bootstrap] ${target} is ready"
else
  echo "[workspace-bootstrap] ${target} already installed"
fi

case "$agent" in
  none) ;;
  codex|claude-code|hermes|deepseek-harness|openclaw)
    if [[ ! -f "$agent_marker" ]]; then
      until run_manager install agents "$agent"; do
        echo "[workspace-bootstrap] ${agent} install failed; retrying in 30 seconds"
        sleep 30
      done
      touch "$agent_marker"
      chown abc:abc "$agent_marker" 2>/dev/null || true
      echo "[workspace-bootstrap] ${agent} is installed; finish setup from its normal UI"
    fi
    ;;
  *) echo "[workspace-bootstrap] unsupported Agent: $agent" >&2 ;;
esac

tailscale_autoconnect

exec sleep infinity
