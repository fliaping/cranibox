#!/usr/bin/with-contenv bash
# s6 service: start all registered systemctl services on container boot.
#
# All operations are idempotent — safe to re-run on s6 restart.
# Runs once through native s6-rc; no idle supervisor is needed.

echo "[systemctl-services] Starting..."

if ! command -v systemctl > /dev/null 2>&1; then
    echo "[systemctl-services] systemctl not found, skipping"
    exit 0
fi

# Snapshot the container's boot-time environment for the user-systemctl wrapper.
# Later interactive `systemctl --user restart ...` calls should use the same
# service-manager environment, not only the caller's shell environment.
USER_LOCAL_RUN_DIR="${HOME}/.local/run"
USER_SYSTEMD_RUN_DIR="${USER_LOCAL_RUN_DIR}/user-systemd"
USER_SYSTEMD_ENV_FILE="${USER_SYSTEMD_RUN_DIR}/environment"
mkdir -p "$USER_SYSTEMD_RUN_DIR"
(
    umask 077
    # Never persist a Tailscale auth key into /config.
    unset TAILSCALE_AUTHKEY TS_AUTHKEY
    export -p > "$USER_SYSTEMD_ENV_FILE"
)
chown abc:abc "$USER_LOCAL_RUN_DIR" 2>/dev/null || true
chown -R abc:abc "$USER_SYSTEMD_RUN_DIR" 2>/dev/null || true
chmod 700 "$USER_SYSTEMD_RUN_DIR" 2>/dev/null || true
if [ -x "$HOME/bin/workspace-services" ]; then
    s6-setuidgid abc "$HOME/bin/workspace-services" __snapshot-env || true
fi

# Wait for Docker daemon (DinD mode only)
if [ "$START_DOCKER" = "true" ] && command -v docker > /dev/null 2>&1; then
    echo "[systemctl-services] Waiting for Docker daemon (max 60s)..."
    for i in $(seq 1 30); do
        if docker info > /dev/null 2>&1; then
            echo "[systemctl-services] Docker ready after $((i * 2))s"
            break
        fi
        [ "$i" -eq 30 ] && echo "[systemctl-services] Docker not ready after 60s, proceeding anyway"
        sleep 2
    done
fi

# Start user-level services as user abc (not root)
# s6-setuidgid changes UID/GID while preserving contenv (HOME=/config)
USER_WANTS_DIR="${HOME}/.config/systemd/user/default.target.wants"
if [ -d "$USER_WANTS_DIR" ]; then
    for link in "$USER_WANTS_DIR"/*.service; do
        [ -L "$link" ] || continue
        name=$(basename "$link" .service)
        echo "[systemctl-services] Starting user service: $name"
        s6-setuidgid abc systemctl --user start "$name" 2>&1 || true
    done
fi

# Start system-level services (filter known container-incompatible noise)
echo "[systemctl-services] Running: systemctl default"
systemctl default 2>&1 | grep -v -E \
    "seatd|ssl-cert|console-setup|modprobe|/sbin/modprobe|WARNING:|ERROR:" \
    || true

echo "[systemctl-services] Done"
