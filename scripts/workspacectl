#!/usr/bin/env bash
# Source-checkout compatibility launcher. Installed workspacectl is a native binary.
set -euo pipefail
if [[ -n "${AGENT_WORKSPACE_CTL_BIN:-}" ]]; then
  exec "$AGENT_WORKSPACE_CTL_BIN" "$@"
fi
script_path="$(readlink -f "${BASH_SOURCE[0]}")"
source_root="$(cd "$(dirname "$script_path")/.." && pwd)"
config_root="${AGENT_WORKSPACE_CONFIG_ROOT:-/config}"
for candidate in "${CARGO_TARGET_DIR:-$source_root/target}/release/workspacectl" "${CARGO_TARGET_DIR:-$source_root/target}/debug/workspacectl" "$config_root/bin/workspacectl"; do
  if [[ -x "$candidate" && "$(readlink -f "$candidate")" != "$script_path" ]]; then
    exec "$candidate" "$@"
  fi
done
echo "Rust workspacectl is not built. Run: bash $source_root/scripts/install-workspacectl.sh" >&2
exit 1
