#!/usr/bin/env python3
"""Application-layer manager for Agent Workspace.

The image provides stable runtime dependencies. This manager installs and
updates application capabilities under /config, so proxy/code-server/agent
logic can evolve without rebuilding the container image.
"""

from __future__ import annotations

import argparse
import importlib.util
import os
import re
import shutil
import subprocess
import sys
import threading
from dataclasses import dataclass
from pathlib import Path
from typing import Callable


APP_NAME = "agent-workspace-manager"
DEFAULT_REPO_URL = "https://github.com/fliaping/cranibox.git"
DEFAULT_CHINA_REPO_URL = "https://gitcode.com/fliaping0/agent-workspace.git"
_OUTPUT_CONTEXT = threading.local()


class ManagerError(RuntimeError):
    pass


@dataclass
class Settings:
    config_root: Path
    state_root: Path
    source_dir: Path
    repo_url: str
    repo_ref: str

    @classmethod
    def from_env(cls) -> "Settings":
        config_root = Path(os.environ.get("CONFIG_ROOT", "/config"))
        state_root = Path(
            os.environ.get(
                "AGENT_WORKSPACE_MANAGER_HOME",
                str(config_root / "agent-workspace-manager"),
            )
        )
        source_dir = Path(
            os.environ.get(
                "AGENT_WORKSPACE_SOURCE_DIR",
                str(state_root / "source"),
            )
        )
        return cls(
            config_root=config_root,
            state_root=state_root,
            source_dir=source_dir,
            repo_url=os.environ.get("AGENT_WORKSPACE_REPO_URL", DEFAULT_REPO_URL),
            repo_ref=os.environ.get("AGENT_WORKSPACE_REPO_REF", "main"),
        )


def log(message: str) -> None:
    emit(f"[{APP_NAME}] {message}")


def emit(message: str) -> None:
    handler = getattr(_OUTPUT_CONTEXT, "handler", None)
    if handler:
        handler(message)
    else:
        print(message)


def set_output_handler(handler: Callable[[str], None] | None) -> None:
    _OUTPUT_CONTEXT.handler = handler


def require_command(command: str) -> str:
    path = shutil.which(command)
    if not path:
        raise ManagerError(f"missing required command: {command}")
    return path


def run(
    args: list[str],
    *,
    cwd: Path | None = None,
    env: dict[str, str] | None = None,
    check: bool = True,
) -> subprocess.CompletedProcess[str]:
    handler = getattr(_OUTPUT_CONTEXT, "handler", None)
    if not handler:
        return subprocess.run(
            args,
            cwd=str(cwd) if cwd else None,
            env=env,
            text=True,
            check=check,
        )

    emit(f"$ {' '.join(args)}")
    process = subprocess.Popen(
        args,
        cwd=str(cwd) if cwd else None,
        env=env,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        bufsize=1,
    )
    assert process.stdout is not None
    for line in process.stdout:
        emit(line.rstrip("\n"))
    returncode = process.wait()
    if check and returncode != 0:
        raise subprocess.CalledProcessError(returncode, args)
    return subprocess.CompletedProcess(args, returncode)


def detect_embedded_source() -> Path | None:
    script_path = Path(__file__).resolve()
    root = script_path.parent.parent
    if (root / "addons").is_dir() and (root / "extensions").is_dir():
        return root
    return None


class WorkspaceManager:
    def __init__(self, settings: Settings) -> None:
        self.settings = settings

    def source_root(self, *, require: bool = True) -> Path | None:
        env_source = os.environ.get("AGENT_WORKSPACE_SOURCE_DIR")
        if env_source:
            source = Path(env_source)
            if source.is_dir():
                return source
            if require:
                raise ManagerError(f"AGENT_WORKSPACE_SOURCE_DIR does not exist: {source}")
            return None

        if (self.settings.source_dir / "scripts").is_dir() and (
            self.settings.source_dir / "addons"
        ).is_dir():
            return self.settings.source_dir

        embedded = detect_embedded_source()
        if embedded:
            return embedded

        if require:
            raise ManagerError("no source tree found; run: agent-workspace-manager update")
        return None

    def update_source(
        self,
        *,
        china_mirror: bool = False,
        repo_url: str | None = None,
        repo_ref: str | None = None,
    ) -> None:
        require_command("git")

        url = repo_url or (DEFAULT_CHINA_REPO_URL if china_mirror else self.settings.repo_url)
        ref = repo_ref or self.settings.repo_ref
        source = self.settings.source_dir

        self.settings.state_root.mkdir(parents=True, exist_ok=True)

        if (source / ".git").is_dir():
            log(f"updating {source} from {url} ({ref})")
            run(["git", "-C", str(source), "remote", "set-url", "origin", url], check=False)
            run(["git", "-C", str(source), "fetch", "--depth", "1", "origin", ref])
            # The checkout is a single-branch shallow clone, so fetching another
            # ref does not create origin/<ref>; FETCH_HEAD always names what was fetched.
            run(["git", "-C", str(source), "checkout", "-B", ref, "FETCH_HEAD"])
        elif source.exists():
            raise ManagerError(f"{source} exists but is not a git checkout")
        else:
            log(f"cloning {url} ({ref}) to {source}")
            run(["git", "clone", "--depth", "1", "--branch", ref, url, str(source)])

        manager = source / "scripts" / "agent-workspace-manager"
        if manager.exists():
            manager.chmod(0o755)

        bin_dir = self.settings.config_root / "bin"
        bin_dir.mkdir(parents=True, exist_ok=True)
        target = bin_dir / "agent-workspace-manager"
        if target.exists() or target.is_symlink():
            target.unlink()
        target.symlink_to(manager)

        log(f"manager source is ready: {source}")
        log(f"persistent command: {target}")
        self.install_workspace_controls()

    def install_workspace_controls(self) -> None:
        """Install the stable Agent-facing command and seed workspace context."""
        root = self.source_root()
        assert root is not None

        bin_dir = self.settings.config_root / "bin"
        bin_dir.mkdir(parents=True, exist_ok=True)
        local_bin_dir = self.settings.config_root / ".local/bin"
        local_bin_dir.mkdir(parents=True, exist_ok=True)

        run(["bash", str(root / "scripts/install-workspacectl.sh")],
            env={**os.environ, "AGENT_WORKSPACE_CONFIG_ROOT": str(self.settings.config_root)})

        if sys.platform.startswith("linux") and shutil.which("s6-svscan"):
            run(["bash", str(root / "scripts/install-workspace-services.sh")],
                env={**os.environ, "AGENT_WORKSPACE_CONFIG_ROOT": str(self.settings.config_root)})

        # Native Agent installers already put ~/.local/bin on PATH. Install
        # these commands there as compatibility links for older images whose
        # PATH predates /config/bin.
        for command in [
            "agent-workspace-manager",
            "agent-workspace-browser",
            "agent-workspace-deb-installer",
            "agent-workspace-deb",
        ]:
            source_command = root / "scripts" / command
            if not source_command.exists():
                raise ManagerError(f"missing workspace control command: {source_command}")
            if not os.access(source_command, os.X_OK):
                raise ManagerError(
                    f"workspace control command is not executable: {source_command}"
                )

            target = bin_dir / command
            if target.exists() or target.is_symlink():
                target.unlink()
            target.symlink_to(source_command)

            local_target = local_bin_dir / command
            if local_target.exists() or local_target.is_symlink():
                local_target.unlink()
            local_target.symlink_to(target)

        applications_dir = self.settings.config_root / ".local/share/applications"
        applications_dir.mkdir(parents=True, exist_ok=True)
        browser_desktop = root / "desktop/chromium.desktop"
        if not browser_desktop.is_file():
            raise ManagerError(f"missing managed browser desktop entry: {browser_desktop}")
        shutil.copyfile(browser_desktop, applications_dir / "chromium.desktop")

        deb_installer_desktop = root / "desktop/deb-installer.desktop"
        if not deb_installer_desktop.is_file():
            raise ManagerError(f"missing Debian package desktop entry: {deb_installer_desktop}")
        deb_installer_target = applications_dir / "agent-workspace-deb-installer.desktop"
        shutil.copyfile(deb_installer_desktop, deb_installer_target)
        deb_installer_target.chmod(0o644)
        xdg_mime = shutil.which("xdg-mime")
        if xdg_mime:
            for mime_type in (
                "application/vnd.debian.binary-package",
                "application/x-deb",
            ):
                run(
                    [
                        xdg_mime,
                        "default",
                        deb_installer_target.name,
                        mime_type,
                    ],
                    check=False,
                )
        update_desktop_database = shutil.which("update-desktop-database")
        if update_desktop_database:
            run([update_desktop_database, str(applications_dir)], check=False)
        if shutil.which("kbuildsycoca6"):
            run(["kbuildsycoca6"], check=False)

        xfce_helper_dir = self.settings.config_root / ".local/share/xfce4/helpers"
        xfce_helper_dir.mkdir(parents=True, exist_ok=True)
        xfce_helper = root / "desktop/xfce4/helpers/chromium.desktop"
        if not xfce_helper.is_file():
            raise ManagerError(f"missing managed browser XFCE helper: {xfce_helper}")
        shutil.copyfile(xfce_helper, xfce_helper_dir / "chromium.desktop")

        panel_root = self.settings.config_root / ".config/xfce4/panel"
        for panel_launcher in panel_root.glob("launcher-*/*.desktop"):
            try:
                content = panel_launcher.read_text(encoding="utf-8")
            except OSError:
                continue
            updated = re.sub(
                r"^Exec=exo-open --launch WebBrowser(?:\s+.*)?$",
                f"Exec={bin_dir / 'agent-workspace-browser'} %u",
                content,
                flags=re.MULTILINE,
            )
            if updated != content:
                panel_launcher.write_text(updated, encoding="utf-8")

        shortcut_file = (
            self.settings.config_root
            / ".config/xfce4/xfconf/xfce-perchannel-xml/xfce4-keyboard-shortcuts.xml"
        )
        if shortcut_file.is_file():
            try:
                shortcut_content = shortcut_file.read_text(encoding="utf-8")
                shortcut_updated = shortcut_content.replace(
                    'value="exo-open --launch WebBrowser"',
                    f'value="{bin_dir / "agent-workspace-browser"}"',
                )
                if shortcut_updated != shortcut_content:
                    shortcut_file.write_text(shortcut_updated, encoding="utf-8")
            except OSError as exc:
                log(f"warning: could not update XFCE browser shortcuts: {exc}")

        workspace_root = self.settings.config_root / "Workspace"
        workspace_root.mkdir(parents=True, exist_ok=True)
        context_root = root / "agent-context"
        for filename in ["AGENTS.md", "CLAUDE.md"]:
            source_context = context_root / filename
            target_context = workspace_root / filename
            if source_context.exists() and not target_context.exists():
                shutil.copyfile(source_context, target_context)
                target_context.chmod(0o644)

        log(f"workspace control commands: {bin_dir}")
        log(f"workspace Agent context: {workspace_root}")
        self.install_deb_runtime()

    def install_deb_runtime(self) -> None:
        """Install persistent Debian controls without refreshing unrelated capabilities."""
        root = self.source_root()
        assert root is not None
        config = self.settings.config_root
        for directory in (config / "bin", config / ".local/bin", config / ".local/share/applications"):
            directory.mkdir(parents=True, exist_ok=True)
        for command in ("agent-workspace-deb", "agent-workspace-deb-native", "agent-workspace-deb-installer"):
            source = root / "scripts" / command
            if not source.is_file() or not os.access(source, os.X_OK):
                raise ManagerError(f"missing executable: {source}")
            for target, origin in ((config / "bin" / command, source),
                                   (config / ".local/bin" / command, config / "bin" / command)):
                if target.exists() or target.is_symlink():
                    target.unlink()
                target.symlink_to(origin)
        desktop = config / ".local/share/applications/agent-workspace-deb-installer.desktop"
        content = (root / "desktop/deb-installer.desktop").read_text()
        desktop.write_text(content.replace("/config/bin/", str(config / "bin") + "/"))
        desktop.chmod(0o644)
        if shutil.which("xdg-mime"):
            for mime in ("application/vnd.debian.binary-package", "application/x-deb"):
                run(["xdg-mime", "default", desktop.name, mime], check=False)
        if shutil.which("update-desktop-database"):
            run(["update-desktop-database", str(desktop.parent)], check=False)
        if shutil.which("kbuildsycoca6"):
            run(["kbuildsycoca6"], check=False)
        service = config / "custom-services.d/deb-native-restore/run"
        service.parent.mkdir(parents=True, exist_ok=True)
        service.write_text((root / "services/deb-native-restore/run").read_text()
                           .replace("/config", str(config)))
        service.chmod(0o755)
        registrar = shutil.which("register-config-services.sh")
        if registrar and Path("/run/service").is_dir():
            command = ["bash", registrar]
            if os.geteuid() != 0:
                command = ["sudo", "-n", *command]
            run(command, check=False)
        log("Debian installer ready: PRoot persistence or native installation with startup replay")

    def install_proxyctl(self) -> None:
        root = self.source_root()
        assert root is not None
        installer = root / "addons" / "proxyctl" / "install.sh"
        if not installer.exists():
            raise ManagerError(f"missing proxyctl installer: {installer}")
        log(f"installing custom-domain routing backend from {installer.parent}")
        run(["bash", str(installer)], cwd=installer.parent)

    def install_mcpm(self) -> None:
        """Install MCPM in a named persistent runtime under /config."""
        runtime = self.settings.config_root / "opt/mcpm"
        venv = runtime / "venv"
        python = venv / "bin/python"
        executable = venv / "bin/mcpm"
        runtime.mkdir(parents=True, exist_ok=True)

        compatible = False
        if python.exists():
            probe = subprocess.run(
                [str(python), "-c", "import sys; print(f'{sys.version_info.major}.{sys.version_info.minor}')"],
                check=False,
                capture_output=True,
                text=True,
            )
            compatible = probe.returncode == 0 and probe.stdout.strip() in {"3.10", "3.11", "3.12", "3.13"}

        if not compatible:
            uv = shutil.which("uv")
            brew = shutil.which("brew")
            log("MCPM currently requires Python 3.10-3.13")
            if uv:
                env = os.environ.copy()
                env["UV_PYTHON_INSTALL_DIR"] = str(runtime / "python")
                log(f"creating a persistent Python 3.13 MCPM environment at {venv}")
                run(
                    [uv, "venv", "--python", "3.13", "--managed-python", "--seed", "--clear", str(venv)],
                    env=env,
                )
            elif brew:
                log("installing Homebrew Python 3.13 for MCPM")
                run([brew, "install", "python@3.13"])
                brew_python = self.settings.config_root / ".linuxbrew/opt/python@3.13/bin/python3.13"
                if not brew_python.exists():
                    raise ManagerError(f"Homebrew Python 3.13 was not found at {brew_python}")
                run([str(brew_python), "-m", "venv", "--clear", str(venv)])
            else:
                raise ManagerError("MCPM needs Python 3.10-3.13; install uv or Homebrew and retry")
        log("installing or updating MCPM")
        run([str(python), "-m", "pip", "install", "--upgrade", "pip", "mcpm"])
        if not executable.exists():
            raise ManagerError("MCPM installer completed but its executable was not found")
        for bin_dir in (
            self.settings.config_root / "bin",
            self.settings.config_root / ".local/bin",
        ):
            bin_dir.mkdir(parents=True, exist_ok=True)
            target = bin_dir / "mcpm"
            if target.exists() or target.is_symlink():
                target.unlink()
            target.symlink_to(executable)
        log(f"persistent MCPM command: {self.settings.config_root / 'bin/mcpm'}")

    def install_code_server(self) -> None:
        root = self.source_root()
        assert root is not None
        installer = root / "addons" / "code-server" / "install.sh"
        if not installer.exists():
            raise ManagerError(f"missing code-server installer: {installer}")
        log("installing code-server")
        run(["bash", str(installer)], cwd=installer.parent)

    def install_code_server_extensions(self) -> None:
        root = self.source_root()
        assert root is not None
        installer = root / "scripts" / "install-code-server-extensions.sh"
        if not installer.exists():
            raise ManagerError(f"missing code-server extension installer: {installer}")
        log("installing code-server extensions")
        run(["bash", str(installer)])

    def install_desktop_integration(self) -> None:
        """Install the code-server bridge for the image-provided Selkies desktop."""
        self.install_code_server_extensions()
        self.install_desktop_bridge()
        log("Selkies Desktop integration is available from Control Center")

    def install_desktop_bridge(self) -> None:
        """Install the loopback Computer Use bridge and configure installed Agents."""
        self.install_workspace_controls()
        root = self.source_root()
        assert root is not None
        installer = root / "addons" / "desktop-bridge" / "install.sh"
        if not installer.exists():
            raise ManagerError(f"missing desktop bridge installer: {installer}")
        log("installing desktop Computer Use bridge")
        run(["bash", str(installer)], cwd=installer.parent)

        resources = self.settings.config_root / "bin/workspacectl"
        available_agents = []
        for agent, binary in {
            "codex": "codex",
            "claude-code": "claude",
            "hermes": "hermes",
            "deepseek-harness": "deepseek-harness",
        }.items():
            if shutil.which(binary):
                available_agents.append(agent)
        if available_agents:
            log(f"configuring desktop MCP for {', '.join(available_agents)}")
            result = run(
                [
                    str(resources),
                    "mcp",
                    "add",
                    "agent-desktop",
                    "--transport",
                    "stdio",
                    "--command-line",
                    str(self.settings.config_root / "bin/agent-desktop-mcp"),
                    "--agents",
                    ",".join(available_agents),
                ],
                check=False,
            )
            if result.returncode != 0:
                log("warning: desktop bridge is installed, but one or more Agent MCP registrations failed")
        else:
            log("no Agent is installed yet; desktop MCP will be added with the first Agent")

    def install_tailscale(self) -> None:
        root = self.source_root()
        assert root is not None
        installer = root / "addons" / "tailscale" / "install.sh"
        if not installer.exists():
            raise ManagerError(f"missing Tailscale installer: {installer}")
        log("installing Tailscale userspace networking")
        run(["bash", str(installer)], cwd=installer.parent)

    def install_custom_services(self) -> None:
        root = self.source_root()
        assert root is not None
        services_dir = self.settings.config_root / "custom-services.d"
        services_dir.mkdir(parents=True, exist_ok=True)

        registrar = shutil.which("register-config-services.sh")
        registrar_path = Path(registrar) if registrar else root / "scripts" / "register-config-services.sh"
        if not registrar_path.exists():
            raise ManagerError(f"missing custom service registrar: {registrar_path}")

        env = os.environ.copy()
        env["CUSTOM_SERVICES_DIR"] = str(services_dir)
        command = ["bash", str(registrar_path)]
        if os.geteuid() != 0:
            # /run/service is root-owned; sudo resets the environment, so pass the directory explicitly.
            command = ["sudo", "-n", "env", f"CUSTOM_SERVICES_DIR={services_dir}", *command]
        log(f"registering custom s6 services from {services_dir}")
        run(command, env=env)

    def load_agent_wizard(self):  # type: ignore[no-untyped-def]
        root = self.source_root()
        assert root is not None
        wizard_path = root / "scripts" / "agent-wizard.py"
        if not wizard_path.exists():
            raise ManagerError(f"missing Agent wizard module: {wizard_path}")

        spec = importlib.util.spec_from_file_location("agent_workspace_agent_wizard", wizard_path)
        if spec is None or spec.loader is None:
            raise ManagerError(f"cannot load Agent wizard module: {wizard_path}")

        module = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(module)
        return module

    def install_agent_capability(self, agent: str) -> None:
        wizard = self.load_agent_wizard()
        if agent not in wizard.AGENTS:
            raise ManagerError(f"unknown Agent: {agent}")

        info = wizard.AGENTS[agent]
        log(f"installing {info['label']}")

        install_cmd = wizard.build_install_command(agent)
        run(install_cmd)
        binary = wizard.find_binary(info.get("binary", agent))
        if not Path(binary).is_file() and not shutil.which(binary):
            raise ManagerError(f"{info['label']} installer completed but its binary was not found")
        log(f"{info['label']} binary installed")

        if info.get("mode") == "service":
            log(f"creating user service for {info['label']}")
            wizard.create_systemd_service(agent)
            # Keep the lightweight user-service supervisor outside the
            # manager's process group so it survives terminal/tool exit.
            run(["setsid", "systemctl", "--user", "enable", "--now", agent])
            log(f"{agent}.service enabled and started")
        else:
            log(f"{info['label']} is an interactive CLI and is ready to launch")

        extension_id = info.get("code_server_extension")
        if extension_id:
            extension_cmd = wizard.build_code_server_extension_command(agent)
            if extension_cmd:
                log(f"installing code-server extension {extension_id}")
                try:
                    run(extension_cmd)
                    log(f"code-server extension {extension_id} installed")
                except subprocess.CalledProcessError as error:
                    log(
                        f"warning: {info['label']} is installed, but code-server "
                        f"extension {extension_id} failed with exit code {error.returncode}"
                    )
            elif wizard.code_server_extension_installed(agent):
                log(f"code-server extension {extension_id} is already installed")
            else:
                log(
                    f"code-server is unavailable; skipped optional extension {extension_id}"
                )

        onboard = info.get("onboard")
        if onboard:
            log(f"next setup step for {info['label']}: {onboard}")

        desktop_mcp = self.settings.config_root / "bin/agent-desktop-mcp"
        if desktop_mcp.exists():
            self.install_workspace_controls()
            root = self.source_root()
            assert root is not None
            resources = self.settings.config_root / "bin/workspacectl"
            log(f"configuring desktop Computer Use MCP for {info['label']}")
            result = run(
                [
                    str(resources),
                    "mcp",
                    "add",
                    "agent-desktop",
                    "--transport",
                    "stdio",
                    "--command-line",
                    str(desktop_mcp),
                    "--agents",
                    agent,
                ],
                check=False,
            )
            if result.returncode != 0:
                log(f"warning: could not add desktop MCP to {info['label']}")

    def install_agent_capabilities(self, agents: list[str]) -> None:
        if not agents:
            agents = ["deepseek-harness"]
        agents = [agent for agent in agents if agent != "--non-interactive"]
        for agent in agents:
            self.install_agent_capability(agent)

    def install_web_control_center(self) -> None:
        root = self.source_root()
        assert root is not None
        self.install_workspace_controls()
        run([str(self.settings.config_root / 'bin/workspacectl'), 'web', 'install'],
            env={**os.environ, 'AGENT_WORKSPACE_CONFIG_ROOT': str(self.settings.config_root)})

    def install(self, target: str, extra_args: list[str]) -> None:
        if target in {"foundation", "base", "remote"}:
            self.install_workspace_controls()
            self.install_code_server()
            self.install_code_server_extensions()
            self.install_desktop_bridge()
            self.install_custom_services()
            self.install_web_control_center()
        elif target in {"code-server", "code", "ide"}:
            self.install_code_server()
        elif target in {"web", "control-center"}:
            self.install_web_control_center()
        elif target in {"proxyctl", "proxy", "caddy"}:
            self.install_proxyctl()
        elif target in {"mcpm", "mcp-manager"}:
            self.install_mcpm()
        elif target in {"desktop", "selkies"}:
            self.install_desktop_integration()
        elif target in {"computer-use", "desktop-bridge", "desktop-control"}:
            self.install_desktop_bridge()
        elif target in {"tailscale", "tailnet"}:
            self.install_tailscale()
        elif target in {"code-server-extensions", "extensions", "vscode"}:
            self.install_code_server_extensions()
        elif target in {"custom-services", "s6"}:
            self.install_custom_services()
        elif target in {"workspace-controls", "controls", "control"}:
            self.install_workspace_controls()
        elif target == "deb-runtime":
            self.install_deb_runtime()
        elif target in {"agents", "agent"}:
            self.install_agent_capabilities(extra_args)
        elif target == "all":
            self.install_code_server()
            self.install_code_server_extensions()
            self.install_desktop_bridge()
            self.install_custom_services()
            self.install_agent_capabilities(extra_args)
            self.install_web_control_center()
        else:
            raise ManagerError(f"unknown install target: {target}")

    def status_rows(self) -> list[tuple[str, str, str]]:
        root = self.source_root(require=False)
        ext_dir = Path(
            os.environ.get(
                "CODE_SERVER_EXTENSIONS_DIR",
                str(self.settings.config_root / ".local/share/code-server/extensions"),
            )
        )

        rows: list[tuple[str, str, str]] = [
            ("manager home", "ok", str(self.settings.state_root)),
            (
                "source",
                "ok" if root else "missing",
                str(root) if root else "run agent-workspace-manager update",
            ),
            (
                "code-server",
                "ok" if (self.settings.config_root / "opt/code-server/bin/code-server").exists() else "missing",
                str(self.settings.config_root / "opt/code-server"),
            ),
            (
                "custom-domain routing",
                "ok"
                if (self.settings.config_root / "proxyctl/bin/caddy").exists()
                and (self.settings.config_root / "proxyctl/env").exists()
                else "optional",
                str(self.settings.config_root / "proxyctl"),
            ),
            (
                "Web Control Center",
                "ok" if (self.settings.config_root / "opt/agent-workspace-web/workspace-web").exists() else "optional",
                "workspacectl web url",
            ),
            (
                "MCPM",
                "ok" if (self.settings.config_root / "bin/mcpm").exists() else "optional",
                str(self.settings.config_root / "opt/mcpm"),
            ),
            (
                "Selkies Desktop",
                "ok"
                if list(ext_dir.glob("agent-workspace.selkies-desktop-*"))
                and Path("/run/service/svc-selkies").exists()
                else "optional",
                "image runtime + code-server integration",
            ),
            (
                "Desktop Computer Use",
                "ok"
                if (self.settings.config_root / "bin/agent-desktop-mcp").exists()
                else "optional",
                "loopback bridge + global MCP",
            ),
            (
                "Tailscale",
                "ok"
                if (self.settings.config_root / "opt/tailscale/libexec/tailscale").exists()
                else "optional",
                str(self.settings.config_root / "opt/tailscale"),
            ),
            (
                "Control Center",
                "ok"
                if list(ext_dir.glob("agent-workspace.control-center-*"))
                else "missing",
                str(ext_dir),
            ),
            (
                "custom s6 services",
                "ok" if (self.settings.config_root / "custom-services.d").is_dir() else "missing",
                str(self.settings.config_root / "custom-services.d"),
            ),
            (
                "workspace controls",
                "ok" if (self.settings.config_root / "bin/workspacectl").exists() else "missing",
                str(self.settings.config_root / "bin/workspacectl"),
            ),
        ]
        return rows

    def print_status(self) -> None:
        for name, state, detail in self.status_rows():
            emit(f"{name:<28} {state:<10} {detail}")

    def doctor_rows(self) -> list[tuple[str, str, str]]:
        rows: list[tuple[str, str, str]] = []
        for command in ["bash", "curl", "git", "jq", "tar", "node", "python3"]:
            path = shutil.which(command)
            rows.append((command, "ok" if path else "missing", path or ""))
        rows.append(("/config exists", "ok" if self.settings.config_root.is_dir() else "missing", str(self.settings.config_root)))
        rows.append(("/config writable", "ok" if os.access(self.settings.config_root, os.W_OK) else "no", str(self.settings.config_root)))
        return rows

    def doctor(self) -> None:
        failed = False
        for name, state, detail in self.doctor_rows():
            emit(f"{name:<28} {state:<10} {detail}")
            failed = failed or state not in {"ok"}
        if failed:
            raise ManagerError("doctor found missing requirements")


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog=APP_NAME,
        description="Install and update Agent Workspace application capabilities under /config.",
    )
    sub = parser.add_subparsers(dest="command")

    update = sub.add_parser("update", help="clone or refresh the application source")
    update.add_argument("--china-mirror", action="store_true")
    update.add_argument("--repo")
    update.add_argument("--ref")

    install = sub.add_parser("install", help="install application capabilities")
    install.add_argument(
        "target",
        nargs="?",
        default="foundation",
        choices=[
            "foundation",
            "web",
            "control-center",
            "base",
            "remote",
            "code-server",
            "code",
            "ide",
            "proxyctl",
            "proxy",
            "caddy",
            "mcpm",
            "mcp-manager",
            "desktop",
            "selkies",
            "computer-use",
            "desktop-bridge",
            "desktop-control",
            "tailscale",
            "tailnet",
            "code-server-extensions",
            "extensions",
            "vscode",
            "custom-services",
            "s6",
            "workspace-controls",
            "deb-runtime",
            "controls",
            "control",
            "agents",
            "agent",
            "all",
        ],
    )
    install.add_argument("extra_args", nargs=argparse.REMAINDER)

    sub.add_parser("status", help="show installed capability status")
    sub.add_parser("doctor", help="run environment checks")
    sub.add_parser("source", help="print selected source tree")
    sub.add_parser("tui", help="open the interactive TUI")
    return parser


def run_cli(argv: list[str], manager: WorkspaceManager) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)

    if args.command is None:
        if sys.stdin.isatty() and sys.stdout.isatty():
            return run_tui(manager)
        parser.print_help()
        return 0

    if args.command == "update":
        manager.update_source(
            china_mirror=args.china_mirror,
            repo_url=args.repo,
            repo_ref=args.ref,
        )
    elif args.command == "install":
        manager.install(args.target, args.extra_args)
    elif args.command == "status":
        manager.print_status()
    elif args.command == "doctor":
        manager.doctor()
    elif args.command == "source":
        root = manager.source_root()
        assert root is not None
        print(root)
    elif args.command == "tui":
        return run_tui(manager)
    return 0


def run_tui(manager: WorkspaceManager) -> int:
    try:
        from textual.app import App, ComposeResult
        from textual.containers import Horizontal, Vertical
        from textual.widgets import DataTable, Footer, Header, Label, ListItem, ListView, RichLog, Static
    except ModuleNotFoundError as exc:
        raise ManagerError(
            "Textual is required for the TUI. Install it with: pip3 install textual"
        ) from exc

    class ManagerApp(App):
        CSS = """
        Screen {
            layout: vertical;
        }
        #body {
            height: 1fr;
            padding: 1 2;
        }
        #actions {
            width: 32;
            padding-right: 2;
        }
        #details {
            width: 1fr;
        }
        ListView {
            width: 100%;
            height: 1fr;
        }
        DataTable {
            height: 45%;
        }
        RichLog {
            height: 1fr;
            border: solid $panel;
        }
        #message {
            height: 2;
        }
        """

        BINDINGS = [
            ("q", "quit", "Quit"),
            ("r", "refresh", "Refresh"),
            ("u", "update_source", "Update source"),
            ("f", "install_foundation", "Install foundation"),
        ]

        ACTIONS = {
            "update": ("Updating application source", "Update application source"),
            "foundation": ("Installing foundation", "Install foundation"),
            "code_server": ("Installing code-server", "Install code-server"),
            "proxyctl": ("Installing custom-domain routing", "Install custom-domain routing"),
            "desktop": ("Installing Selkies Desktop integration", "Install Selkies Desktop integration"),
            "computer_use": ("Installing desktop Computer Use", "Install desktop Computer Use"),
            "tailscale": ("Installing Tailscale", "Install Tailscale userspace network"),
            "mcpm": ("Installing MCPM", "Install global MCP manager"),
            "extensions": ("Installing code-server extensions", "Install code-server extensions"),
            "custom_services": ("Registering custom services", "Register custom s6 services"),
            "workspace_controls": ("Installing workspace controls", "Install workspace controls"),
            "agents_all": ("Installing Agents", "Install Agents: all"),
            "codex": ("Installing Codex", "Install Agent: Codex"),
            "claude_code": ("Installing Claude Code", "Install Agent: Claude Code"),
            "hermes": ("Installing Hermes Agent", "Install Agent: Hermes"),
            "deepseek_harness": ("Installing DeepSeek Harness", "Install Agent: DeepSeek Harness"),
            "openclaw": ("Installing OpenClaw", "Install Agent: OpenClaw"),
            "openfang": ("Installing Openfang", "Install Agent: Openfang"),
            "zeroclaw": ("Installing Zeroclaw", "Install Agent: Zeroclaw"),
            "doctor": ("Running doctor", "Doctor"),
            "refresh": ("Refreshing status", "Refresh"),
        }

        def compose(self) -> ComposeResult:
            yield Header(show_clock=True)
            with Horizontal(id="body"):
                with Vertical(id="actions"):
                    yield Static("Actions")
                    yield ListView(
                        *[
                            ListItem(Label(label), id=action_id)
                            for action_id, (_, label) in self.ACTIONS.items()
                        ],
                        id="action_list",
                    )
                with Vertical(id="details"):
                    yield Static("Application capabilities", id="title")
                    yield DataTable(id="status")
                    yield Static("", id="message")
                    yield RichLog(id="log", highlight=True, markup=False, wrap=True)
            yield Footer()

        def on_mount(self) -> None:
            self.busy = False
            table = self.query_one("#status", DataTable)
            table.add_columns("Capability", "Status", "Detail")
            self.refresh_status()
            action_list = self.query_one("#action_list", ListView)
            action_list.index = 0
            action_list.focus()
            self.append_log("Use Up/Down to choose an action, Enter to run it.")

        def refresh_status(self) -> None:
            table = self.query_one("#status", DataTable)
            table.clear()
            for row in manager.status_rows():
                table.add_row(*row)

        def set_message(self, message: str) -> None:
            self.query_one("#message", Static).update(message)

        def append_log(self, message: str) -> None:
            self.query_one("#log", RichLog).write(message)

        def action_callable(self, action_id: str):  # type: ignore[no-untyped-def]
            actions = {
                "update": manager.update_source,
                "foundation": lambda: manager.install("foundation", []),
                "code_server": manager.install_code_server,
                "proxyctl": manager.install_proxyctl,
                "desktop": manager.install_desktop_integration,
                "computer_use": manager.install_desktop_bridge,
                "tailscale": manager.install_tailscale,
                "mcpm": manager.install_mcpm,
                "extensions": manager.install_code_server_extensions,
                "custom_services": manager.install_custom_services,
                "workspace_controls": manager.install_workspace_controls,
                "agents_all": lambda: manager.install_agent_capabilities(list(manager.load_agent_wizard().AGENTS)),
                "codex": lambda: manager.install_agent_capability("codex"),
                "claude_code": lambda: manager.install_agent_capability("claude-code"),
                "hermes": lambda: manager.install_agent_capability("hermes"),
                "deepseek_harness": lambda: manager.install_agent_capability("deepseek-harness"),
                "openclaw": lambda: manager.install_agent_capability("openclaw"),
                "openfang": lambda: manager.install_agent_capability("openfang"),
                "zeroclaw": lambda: manager.install_agent_capability("zeroclaw"),
                "doctor": manager.doctor,
                "refresh": lambda: None,
            }
            return actions[action_id]

        def run_task(self, label: str, func) -> None:  # type: ignore[no-untyped-def]
            if self.busy:
                self.set_message("A task is already running")
                return
            self.busy = True
            self.set_message(f"{label}...")
            self.append_log("")
            self.append_log(f"==> {label}")
            self.run_worker(
                lambda: self.run_task_worker(label, func),
                thread=True,
                exclusive=True,
            )

        def run_task_worker(self, label: str, func) -> None:  # type: ignore[no-untyped-def]
            set_output_handler(lambda line: self.call_from_thread(self.append_log, line))
            try:
                func()
            except Exception as exc:  # noqa: BLE001 - displayed to operator in TUI
                self.call_from_thread(self.set_message, f"{label} failed: {exc}")
                self.call_from_thread(self.append_log, f"ERROR: {exc}")
            else:
                self.call_from_thread(self.set_message, f"{label} complete")
                self.call_from_thread(self.refresh_status)
            finally:
                set_output_handler(None)
                self.call_from_thread(self.clear_busy)

        def clear_busy(self) -> None:
            self.busy = False

        def on_list_view_selected(self, event: ListView.Selected) -> None:
            action_id = event.item.id or ""
            label = self.ACTIONS[action_id][0]
            self.run_task(label, self.action_callable(action_id))

        def action_refresh(self) -> None:
            self.refresh_status()
            self.set_message("Status refreshed")

        def action_update_source(self) -> None:
            self.run_task("Updating application source", manager.update_source)

        def action_install_foundation(self) -> None:
            self.run_task("Installing foundation", lambda: manager.install("foundation", []))

    ManagerApp().run()
    return 0


def main(argv: list[str] | None = None) -> int:
    manager = WorkspaceManager(Settings.from_env())
    try:
        return run_cli(sys.argv[1:] if argv is None else argv, manager)
    except ManagerError as exc:
        print(f"[{APP_NAME}] ERROR: {exc}", file=sys.stderr)
        return 1
    except subprocess.CalledProcessError as exc:
        print(
            f"[{APP_NAME}] ERROR: command failed ({exc.returncode}): {' '.join(exc.cmd)}",
            file=sys.stderr,
        )
        return exc.returncode or 1


if __name__ == "__main__":
    raise SystemExit(main())
