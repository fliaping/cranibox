#!/usr/bin/env bash
# Agent Workspace moved to github.com/fliaping/agent-workspace (2026-11).
# Workspaces whose manager source still follows this repository land here after
# `agent-workspace-manager update`: switch the source to the new repository with
# the image's built-in manager, then run the requested command with it.
set -euo pipefail
url="${AGENT_WORKSPACE_REPO_URL:-https://github.com/fliaping/agent-workspace.git}"
case "$url" in *fliaping/cranibox*) url=https://github.com/fliaping/agent-workspace.git ;; esac
builtin=/usr/local/bin/agent-workspace-manager
config_root="${AGENT_WORKSPACE_CONFIG_ROOT:-/config}"
echo "Agent Workspace moved to $url; switching this workspace's manager source." >&2
[[ -x "$builtin" ]] || { echo "Run: AGENT_WORKSPACE_REPO_URL=$url agent-workspace-manager update" >&2; exit 1; }
AGENT_WORKSPACE_REPO_URL="$url" "$builtin" update
manager="$config_root/bin/agent-workspace-manager"
[[ "$(readlink -f "$manager")" != "$(readlink -f "${BASH_SOURCE[0]}")" ]] || { echo "Manager source did not switch to $url" >&2; exit 1; }
[[ $# == 0 || "$*" == update ]] && exit 0
exec "$manager" "$@"
