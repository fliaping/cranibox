#!/usr/bin/env bash
set -euo pipefail

config_root="${AGENT_WORKSPACE_CONFIG_ROOT:-/config}"
timezone_file="$config_root/.config/agent-workspace/timezone"
if [[ -r "$timezone_file" ]]; then
  IFS= read -r TZ < "$timezone_file"
  export TZ
fi
profile_root="${AGENT_WORKSPACE_BROWSER_PROFILE:-$config_root/.config/agent-browser}"
legacy_profile="${AGENT_WORKSPACE_BROWSER_LEGACY_PROFILE:-$config_root/.config/chromium}"
profile_name="${AGENT_WORKSPACE_BROWSER_PROFILE_NAME:-Agent Workspace (Managed)}"
debug_port="${AGENT_WORKSPACE_BROWSER_PORT:-9222}"
browser_bin="${AGENT_WORKSPACE_BROWSER_BIN:-/usr/bin/chromium}"
log_root="$config_root/.local/log"

if [[ ! "$debug_port" =~ ^[0-9]+$ ]] || (( debug_port < 1024 || debug_port > 65535 )); then
  echo "Invalid AGENT_WORKSPACE_BROWSER_PORT: $debug_port" >&2
  exit 2
fi
if [[ ! -x "$browser_bin" ]]; then
  echo "Chromium executable is unavailable: $browser_bin" >&2
  exit 1
fi

managed_browser_running() {
  local pid command_line executable
  for pid_path in /proc/[0-9]*; do
    pid="${pid_path##*/}"
    [[ "$pid" =~ ^[0-9]+$ ]] || continue
    executable="$(readlink "$pid_path/exe" 2>/dev/null || true)"
    case "${executable##*/}" in
      chromium|chrome|google-chrome) ;;
      *) continue ;;
    esac
    command_line="$(tr '\0' ' ' <"$pid_path/cmdline" 2>/dev/null || true)"
    if [[ "$command_line" != *"--type="* && "$command_line" == *"--user-data-dir=$profile_root"* ]]; then
      if [[ "${AGENT_WORKSPACE_BROWSER_DEBUG:-0}" == "1" ]]; then
        echo "Managed Chromium process: $pid ($executable) $command_line" >&2
      fi
      return 0
    fi
  done
  return 1
}

any_browser_running() {
  local pid command_line executable
  for pid_path in /proc/[0-9]*; do
    pid="${pid_path##*/}"
    [[ "$pid" =~ ^[0-9]+$ ]] || continue
    command_line="$(tr '\0' ' ' <"$pid_path/cmdline" 2>/dev/null || true)"
    executable="${command_line%% *}"
    case "${executable##*/}" in
      chromium|chrome|google-chrome) return 0 ;;
    esac
  done
  return 1
}

migrate_legacy_profile() {
  local profile_parent migration_root
  [[ -e "$profile_root" ]] && return 0
  profile_parent="$(dirname "$profile_root")"
  mkdir -p "$profile_parent" "$log_root"

  if [[ ! -f "$legacy_profile/Local State" ]]; then
    mkdir -p "$profile_root"
    printf 'created=%s\nsource=new\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
      >"$profile_root/.agent-workspace-managed"
    return 0
  fi

  if any_browser_running; then
    echo "The existing Chromium must be closed once before its profile can be migrated." >&2
    echo "Close Chromium in the desktop, then open it again." >&2
    if command -v notify-send >/dev/null 2>&1; then
      notify-send "Agent Workspace Browser" \
        "Close the existing Chromium once, then reopen it to enable managed Agent control." || true
    fi
    return 1
  fi

  migration_root="$(mktemp -d "$profile_parent/.agent-browser-migration.XXXXXX")"
  trap 'rm -rf -- "$migration_root"' RETURN
  (
    cd "$legacy_profile"
    tar \
      --exclude='./Singleton*' \
      --exclude='./DevToolsActivePort' \
      --exclude='./CrashpadMetrics-active.pma' \
      -cf - .
  ) | tar -xf - -C "$migration_root"
  printf 'created=%s\nsource=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$legacy_profile" \
    >"$migration_root/.agent-workspace-managed"
  mv "$migration_root" "$profile_root"
  trap - RETURN
  echo "Copied the existing Chromium profile to $profile_root"
}

migrate_legacy_profile

set_profile_name() {
  managed_browser_running && return 0
  python3 - "$profile_root" "$profile_name" <<'PY'
import json
import os
import pathlib
import re
import sys
import tempfile

root = pathlib.Path(sys.argv[1])
display_name = sys.argv[2].strip()
if not display_name:
    raise SystemExit(0)


def read_json(path):
    if not path.is_file():
        return {}
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        print(f"Could not update Chromium profile name in {path}: {error}", file=sys.stderr)
        return None
    return value if isinstance(value, dict) else {}


def write_json(path, value):
    path.parent.mkdir(parents=True, exist_ok=True)
    descriptor, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as output:
            json.dump(value, output, ensure_ascii=False, separators=(",", ":"))
        os.replace(temporary, path)
    finally:
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass


local_state_path = root / "Local State"
local_state = read_json(local_state_path)
profile_directory = "Default"
if local_state is not None:
    profile_state = local_state.setdefault("profile", {})
    candidate = profile_state.get("last_used", "Default")
    if isinstance(candidate, str) and re.fullmatch(r"Default|Profile [0-9]+", candidate):
        profile_directory = candidate
    if local_state_path.is_file():
        info_cache = profile_state.setdefault("info_cache", {})
        info = info_cache.setdefault(profile_directory, {})
        info["name"] = display_name
        info["is_using_default_name"] = False
        write_json(local_state_path, local_state)

preferences_path = root / profile_directory / "Preferences"
preferences = read_json(preferences_path)
if preferences is not None:
    profile_preferences = preferences.setdefault("profile", {})
    profile_preferences["name"] = display_name
    profile_preferences["is_using_default_name"] = False
    write_json(preferences_path, preferences)

(root / ".agent-workspace-profile-name").write_text(
    f"{display_name}\n", encoding="utf-8"
)
PY
}

set_profile_name

if ! managed_browser_running; then
  rm -f -- "$profile_root"/SingletonLock "$profile_root"/SingletonCookie \
    "$profile_root"/SingletonSocket "$profile_root"/DevToolsActivePort
fi

browser_args=(
  --password-store=basic
  "--user-data-dir=$profile_root"
  --remote-debugging-address=127.0.0.1
  "--remote-debugging-port=$debug_port"
  --no-first-run
)

if ! grep -q 'Seccomp:.0' /proc/1/status; then
  browser_args+=(--no-sandbox --test-type)
fi

exec "$browser_bin" "${browser_args[@]}" "$@"
