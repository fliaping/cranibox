#!/usr/bin/env python3
"""Install and run desktop Debian packages in a persistent, user-owned rootfs."""
from __future__ import annotations

import argparse
from collections import deque
import configparser
import contextlib
import fcntl
import hashlib
import html
import json
import os
from pathlib import Path
import platform
import re
import shutil
import socket
import subprocess
import sys
import tarfile
import tempfile
import threading
import time
import urllib.request
import uuid

# Immutable Ubuntu Base release; hashes from Canonical's HTTPS SHA256SUMS.
BASE_URL = 'https://cdimage.ubuntu.com/ubuntu-base/releases/24.04/release/'
BASE_VERSION = '24.04.4'
BASE_HASHES = {
    'amd64': 'c1e67ef7b17a6300e136118bd1dc04725009cb376c1aad10abcf8cd453628d58',
    'arm64': '04207713ece899c3740823d33690441ad3a7f0ded1101aca744e2b0f37ac7ff2',
}
PACKAGE_RE = re.compile(r'^[a-z0-9][a-z0-9+.-]+(?::[a-z0-9]+)?$')


def atomic_json(path: Path, value: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_suffix('.tmp')
    temporary.write_text(json.dumps(value, ensure_ascii=False, indent=2) + '\n')
    temporary.replace(path)


def digest(path: Path) -> str:
    with path.open('rb') as stream:
        return hashlib.file_digest(stream, 'sha256').hexdigest()


def desktop_quote(value: str) -> str:
    # Desktop Entry quoting: escape Exec characters, then value backslashes.
    slash = chr(92)
    value = value.replace(slash, slash * 2)
    for character in (chr(34), chr(96), chr(36)):
        value = value.replace(character, slash + character)
    return chr(34) + value.replace(slash, slash * 2) + chr(34)


def desktop_config() -> configparser.ConfigParser:
    parser = configparser.ConfigParser(interpolation=None, delimiters=('=',), strict=False)
    parser.optionxform = str
    return parser


class Runtime:
    label = 'Persistent'
    proot_mode = True
    desktop_prefix = 'agent-workspace-deb-'
    app_log_directory = 'deb-apps'

    def __init__(self) -> None:
        self.config = Path(os.environ.get('AGENT_WORKSPACE_CONFIG_ROOT', '/config')).resolve()
        self.state = self.config / '.local/share/agent-workspace/deb-runtime'
        self.root = self.state / 'rootfs'
        self.cache = self.config / '.cache/agent-workspace/debs'
        self.manifest = self.state / 'packages.json'
        self.launchers = self.config / '.local/share/applications'
        self.icons = self.config / '.local/share/icons/agent-workspace-deb'
        self.log = self.config / '.local/log/agent-workspace/deb-runtime.log'
        self.overrides = self.config / '.config/agent-workspace/deb-apps.json'
        self.arch = {'x86_64': 'amd64', 'aarch64': 'arm64'}.get(platform.machine())
        self.proot = self.config / '.local/bin/proot'
        self.command = self.config / 'bin/agent-workspace-deb'

    @contextlib.contextmanager
    def lock(self, *, exclusive_apps=False):
        self.state.mkdir(parents=True, exist_ok=True)
        with (self.state / 'operation.lock').open('a') as handle:
            try:
                fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                raise RuntimeError('Another persistent package operation is running.') from None
            # Serialize package writers, but allow normal apt operations while
            # apps run. Only whole-rootfs operations need applications stopped.
            with self.app_lock(shared=not exclusive_apps):
                yield

    @contextlib.contextmanager
    def app_lock(self, *, shared):
        self.state.mkdir(parents=True, exist_ok=True)
        with (self.state / 'applications.lock').open('a') as handle:
            mode = fcntl.LOCK_SH if shared else fcntl.LOCK_EX
            try:
                fcntl.flock(handle, mode | fcntl.LOCK_NB)
            except BlockingIOError:
                message = ('Runtime initialization, backup or restore is running; try again afterwards.' if shared
                           else 'Close persistent applications before runtime initialization, backup or restore.')
                raise RuntimeError(message) from None
            yield

    def load(self) -> dict:
        if not self.manifest.exists():
            return {'schema': 1, 'packages': {}}
        return json.loads(self.manifest.read_text())

    def require_ready(self) -> None:
        if not (self.state / 'ready.json').exists():
            raise RuntimeError('Runtime is not initialized. Run: agent-workspace-deb init')
        if not (self.root / 'usr/bin/apt-get').is_file():
            raise RuntimeError('Runtime rootfs is missing or incomplete; inspect its state before retrying.')

    def environment(self, install: bool) -> dict[str, str]:
        env = {
            'PATH': '/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin',
            'HOME': '/root' if install else str(self.config),
            'USER': 'root' if install else os.environ.get('USER', 'abc'),
            'LOGNAME': 'root' if install else os.environ.get('USER', 'abc'),
            'SHELL': '/bin/bash', 'LANG': 'C.UTF-8', 'PROOT_NO_SECCOMP': '1',
        }
        if install:
            env['DEBIAN_FRONTEND'] = 'noninteractive'
            # Large xz payloads can crash dpkg-deb's parallel decompressor under
            # PRoot. Keep package operations single-threaded, including retries.
            env['DPKG_DEB_THREADS_MAX'] = '1'
        else:
            for key in ('DISPLAY', 'WAYLAND_DISPLAY', 'XAUTHORITY', 'XDG_RUNTIME_DIR',
                        'DBUS_SESSION_BUS_ADDRESS', 'PULSE_SERVER', 'PULSE_COOKIE',
                        'XDG_CURRENT_DESKTOP', 'XDG_SESSION_TYPE', 'LANG', 'LC_ALL', 'TERM',
                        'COLORTERM'):
                if key in os.environ:
                    env[key] = os.environ[key]
            env['XDG_DATA_DIRS'] = '/usr/local/share:/usr/share'
        return env

    def invocation(self, argv: list[str], *, install=False, cwd=None, binds=()) -> list[str]:
        if not os.access(self.proot, os.X_OK):
            raise RuntimeError(f'Persistent PRoot binary is unavailable: {self.proot}')
        command = [str(self.proot), '-r', str(self.root)]
        if install:
            command += ['-0']
        # Do not use -R during installation: it exposes the host passwd/group.
        mappings = [(p, p) for p in ('/dev', '/proc', '/sys', '/etc/resolv.conf')]
        if not install:
            mappings += [(str(self.config), str(self.config))]
            mappings += [(p, p) for p in ('/tmp', '/etc/passwd', '/etc/group',
                         '/run/user', '/run/dbus/system_bus_socket', '/var/run/pulse', '/defaults')]
        mappings += list(binds)
        for source, target in mappings:
            if Path(source).exists():
                if ':' in source or ':' in target:
                    raise RuntimeError('PRoot bind paths cannot contain a colon.')
                command += ['-b', f'{source}:{target}!']
        command += ['-w', cwd or ('/' if install else str(self.config))]
        return command + argv

    def execute(self, argv: list[str], *, install=False, capture=False, cwd=None, binds=(), check=True):
        command = self.invocation(argv, install=install, cwd=cwd, binds=binds)
        if not install or capture:
            return subprocess.run(command, env=self.environment(install), text=True,
                                  stdout=subprocess.PIPE if capture else None, check=check)
        self.log.parent.mkdir(parents=True, exist_ok=True)
        with self.log.open('a', buffering=1) as log:
            print(time.strftime('[%Y-%m-%dT%H:%M:%S%z]'), json.dumps(argv), file=log)
            process = subprocess.Popen(command, env=self.environment(True), text=True,
                                       stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
            try:
                for line in process.stdout:
                    print(line, end='', flush=True)
                    log.write(line)
                code = process.wait()
            except BaseException:
                process.terminate()
                try:
                    process.wait(timeout=10)
                except subprocess.TimeoutExpired:
                    process.kill()
                    process.wait()
                raise
            finally:
                process.stdout.close()
            print(f'[exit={code}]', file=log)
        if check and code:
            raise subprocess.CalledProcessError(code, command)
        return subprocess.CompletedProcess(command, code)

    def apt(self, args: list[str], *, binds=(), check=True):
        return self.execute(['apt-get', '-o', 'APT::Sandbox::User=root',
                             '-o', 'Dpkg::Options::=--force-confold',
                             '-o', 'Acquire::Retries=3', *args],
                            install=True, binds=binds, check=check)

    def init(self) -> None:
        if (self.state / 'ready.json').exists():
            self.require_ready()
            self.install_open_shim()
            return
        if self.arch not in BASE_HASHES:
            raise RuntimeError('Supported native architectures: amd64, arm64.')
        if not os.access(self.proot, os.X_OK):
            raise RuntimeError(f'PRoot must first be installed at {self.proot}')
        self.state.mkdir(parents=True, exist_ok=True)
        self.cache.mkdir(parents=True, exist_ok=True)
        if not self.root.exists():
            name = f'ubuntu-base-{BASE_VERSION}-base-{self.arch}.tar.gz'
            archive = self.cache / name
            expected = BASE_HASHES[self.arch]
            if not archive.exists() or digest(archive) != expected:
                print(f'Downloading Ubuntu Base {BASE_VERSION} ({self.arch})…', flush=True)
                part = archive.with_suffix('.part')
                with urllib.request.urlopen(BASE_URL + name, timeout=60) as response, part.open('wb') as output:
                    shutil.copyfileobj(response, output)
                if digest(part) != expected:
                    part.unlink()
                    raise RuntimeError('Ubuntu Base checksum mismatch.')
                part.replace(archive)
            with tempfile.TemporaryDirectory(prefix='.bootstrap-', dir=self.state) as temporary:
                subprocess.run(['tar', '-xzf', str(archive), '-C', temporary, '--no-same-owner',
                                '--exclude=dev/*'], check=True)
                Path(temporary).rename(self.root)
        # A failed package bootstrap can be resumed; never overwrite an existing rootfs.
        self.configure_root()
        self.install_open_shim()
        self.apt(['update'])
        self.apt(['install', '-y', '--no-install-recommends', 'ca-certificates', 'gpg', 'locales',
                  'fonts-wqy-microhei', 'dbus-x11', 'xdg-utils'])
        self.execute(['localedef', '-i', 'zh_CN', '-f', 'UTF-8', 'zh_CN.UTF-8'], install=True)
        self.execute(['localedef', '-i', 'en_US', '-f', 'UTF-8', 'en_US.UTF-8'], install=True)
        atomic_json(self.state / 'ready.json', {'schema': 1, 'distribution': 'ubuntu',
                    'release': '24.04', 'base': BASE_VERSION, 'arch': self.arch})
        print(f'Persistent Ubuntu environment ready: {self.root}', flush=True)

    def configure_root(self) -> None:
        for directory in ('tmp', 'root', 'dev', 'proc', 'sys', 'run', 'etc/apt/apt.conf.d',
                          'etc/apt/sources.list.d', 'usr/sbin', 'usr/local/bin', 'workspace-install'):
            (self.root / directory).mkdir(parents=True, exist_ok=True)
        path = self.root / 'etc/resolv.conf'
        if path.is_symlink():
            path.unlink()
        path.touch()
        # apt authenticates repository metadata. HTTP works before CA bootstrap.
        mirror = 'http://archive.ubuntu.com/ubuntu' if self.arch == 'amd64' else 'http://ports.ubuntu.com/ubuntu-ports'
        security = 'http://security.ubuntu.com/ubuntu' if self.arch == 'amd64' else mirror
        (self.root / 'etc/apt/sources.list').write_text(
            f'deb {mirror} noble main universe restricted multiverse\n'
            f'deb {mirror} noble-updates main universe restricted multiverse\n'
            f'deb {security} noble-security main universe restricted multiverse\n')
        sources = self.root / 'etc/apt/sources.list.d/ubuntu.sources'
        if sources.exists():
            sources.rename(sources.with_suffix('.disabled'))
        policy = self.root / 'usr/sbin/policy-rc.d'
        policy.write_text('#!/bin/sh\n# Services are managed outside this application environment.\nexit 101\n')
        policy.chmod(0o755)

    def install_open_shim(self) -> None:
        shim = self.root / 'usr/local/bin/xdg-open'
        shim.parent.mkdir(parents=True, exist_ok=True)
        shim.write_text(
            '#!/bin/sh\n'
            'if [ "$#" -eq 1 ] && [ -n "$AGENT_WORKSPACE_DEB_OPEN_SOCKET" ] && '
            '[ -x "$AGENT_WORKSPACE_DEB_NCAT" ]; then\n'
            '  reply=$(printf "%s" "$1" | "$AGENT_WORKSPACE_DEB_NCAT" -w 3 -i 5 -U "$AGENT_WORKSPACE_DEB_OPEN_SOCKET")\n'
            '  [ "$reply" = OK ]\n'
            'else\n  exec /usr/bin/xdg-open "$@"\nfi\n')
        shim.chmod(0o755)

    @contextlib.contextmanager
    def open_bridge(self, env: dict):
        """Forward xdg-open targets, never shell commands, to the current desktop."""
        ncat = self.config / '.local/bin/ncat'
        opener = shutil.which('xdg-open')
        if not os.access(ncat, os.X_OK) or not opener:
            yield
            return
        directory = self.config / '.local/run/deb-open'
        directory.mkdir(parents=True, exist_ok=True, mode=0o700)
        path = directory / (uuid.uuid4().hex[:16] + '.sock')
        if len(os.fsencode(path)) >= 104:
            raise RuntimeError('Config path is too long for a desktop bridge socket.')
        server = socket.socket(socket.AF_UNIX)
        server.bind(str(path))
        path.chmod(0o600)
        server.listen(4)
        server.settimeout(0.2)
        stopped = threading.Event()

        def serve():
            while not stopped.is_set():
                try:
                    connection, _ = server.accept()
                except socket.timeout:
                    continue
                except OSError:
                    break
                try:
                    with connection:
                        connection.settimeout(2)
                        message = bytearray()
                        while len(message) <= 65536:
                            chunk = connection.recv(4096)
                            if not chunk:
                                break
                            message.extend(chunk)
                        target = message.decode('utf-8')
                        if not target or len(message) > 65536 or target.startswith('-') or chr(0) in target:
                            continue
                        # The guest and desktop share /config and /tmp. Other guest paths
                        # are not necessarily meaningful to an external file manager.
                        self.log.parent.mkdir(parents=True, exist_ok=True)
                        with self.log.open('a') as log:
                            process = subprocess.Popen([opener, target], stdin=subprocess.DEVNULL,
                                                       stdout=log, stderr=log)
                        threading.Thread(target=process.wait, daemon=True).start()
                        connection.sendall(b'OK')
                except (OSError, UnicodeError):
                    continue

        thread = threading.Thread(target=serve, daemon=True)
        thread.start()
        env['AGENT_WORKSPACE_DEB_OPEN_SOCKET'] = str(path)
        env['AGENT_WORKSPACE_DEB_NCAT'] = str(ncat)
        try:
            yield
        finally:
            stopped.set()
            server.close()
            thread.join(timeout=3)
            path.unlink(missing_ok=True)

    def metadata(self, package: Path) -> dict:
        package = package.resolve(strict=True)
        if not package.is_file() or package.suffix != '.deb':
            raise RuntimeError('Expected a local .deb file.')
        output = subprocess.check_output(['dpkg-deb', '--field', str(package),
                                           'Package', 'Version', 'Architecture'], text=True)
        fields = dict(line.split(': ', 1) for line in output.splitlines() if ': ' in line)
        name = fields.get('Package', '')
        if not PACKAGE_RE.fullmatch(name):
            raise RuntimeError('Invalid Debian package name.')
        if fields.get('Architecture') not in ('all', self.arch):
            raise RuntimeError(f'Package architecture {fields.get("Architecture")} does not match {self.arch}.')
        return {'name': name, 'version': fields['Version'], 'arch': fields['Architecture']}

    def install(self, package: Path, simulate: bool) -> None:
        details = self.metadata(package)
        if simulate:
            self.require_ready()
            # Simulation has no cache writes or bootstrap side effects.
            self.apt(['--simulate', '--no-remove', 'install', '/workspace-install/package.deb'],
                     binds=[(str(package.resolve()), '/workspace-install/package.deb')])
            return
        self.init()
        checksum = digest(package)
        cached = self.cache / f'{details["name"]}-{checksum}.deb'
        if not cached.exists():
            shutil.copyfile(package, cached)
        if digest(cached) != checksum:
            raise RuntimeError('Cached Debian package checksum mismatch.')
        state = self.load()
        previous = state['packages'].get(details['name'], {})
        state['packages'][details['name']] = {**previous, **details, 'sha256': checksum,
                'archive': str(cached), 'status': 'installing', 'updated_at': int(time.time())}
        atomic_json(self.manifest, state)
        try:
            self.apt(['update'])
            self.apt(['install', '-y', '--no-remove', '/workspace-install/package.deb'],
                     binds=[(str(cached), '/workspace-install/package.deb')])
        except BaseException:
            state['packages'][details['name']]['status'] = 'failed'
            atomic_json(self.manifest, state)
            raise
        self.sync()

    def installed(self, package: str) -> tuple[bool, str]:
        query_format = '-f=$' + '{Status}\t$' + '{Version}'
        result = self.execute(['dpkg-query', '-W', query_format, package],
                              install=True, capture=True, check=False)
        status, _, version = result.stdout.partition('\t')
        return result.returncode == 0 and status == 'install ok installed', version

    def guest_file(self, path: str) -> Path | None:
        # Resolve symlinks using guest-root semantics, including absolute links.
        if '..' in Path(path).parts:
            return None
        remaining = deque(Path(path).parts)
        resolved = []
        links = 0
        while remaining:
            part = remaining.popleft()
            if part in ('/', '.'):
                continue
            if part == '..':
                if resolved:
                    resolved.pop()
                continue
            candidate = self.root.joinpath(*resolved, part)
            if candidate.is_symlink():
                links += 1
                if links > 40:
                    return None
                target = os.readlink(candidate)
                if target.startswith('/'):
                    resolved = []
                remaining.extendleft(reversed(Path(target).parts))
            else:
                resolved.append(part)
        candidate = self.root.joinpath(*resolved)
        return candidate if candidate.is_file() else None

    def export_desktop(self, package: str, source: str, files: list[str]) -> str | None:
        path = self.guest_file(source)
        if not path:
            return None
        entry = desktop_config()
        entry.read(path, encoding='utf-8')
        if 'Desktop Entry' not in entry or entry['Desktop Entry'].get('Type') != 'Application':
            return None
        main = entry['Desktop Entry']
        if not main.get('Exec'):
            return None
        identifier = self.desktop_prefix + package.replace(':', '-') + '-' + hashlib.sha256(source.encode()).hexdigest()[:12]
        icon = main.get('Icon', '')
        candidates = [icon] if icon.startswith('/') else [
            f for f in files if Path(f).stem == icon and Path(f).suffix in ('.png', '.svg', '.xpm')]
        for candidate in sorted(candidates, key=lambda f: (not f.endswith('.svg'), f)):
            icon_file = self.guest_file(candidate)
            if icon_file:
                self.icons.mkdir(parents=True, exist_ok=True)
                target = self.icons / (identifier + icon_file.suffix)
                shutil.copyfile(icon_file, target)
                main['Icon'] = str(target)
                break
        working_directory = main.pop('Path', '')
        prefix = desktop_quote(str(self.command)) + ' run --desktop --package ' + desktop_quote(package)
        if working_directory:
            prefix += ' --cwd ' + desktop_quote(working_directory)
        # Preserve original field codes, quoting, localized labels and desktop actions.
        # The desktop launcher expands file/URI arguments before our argv-only wrapper.
        for section in entry.sections():
            group = entry[section]
            if section == 'Desktop Entry' or section.startswith('Desktop Action '):
                if 'Exec' in group:
                    group['Exec'] = prefix + ' -- ' + group['Exec']
                group.pop('TryExec', None)
        main['DBusActivatable'] = 'false'
        main['X-Agent-Workspace-Deb-Package'] = package
        for key in list(main):
            if key == 'Name' or key.startswith('Name['):
                main[key] += f' ({self.label})'
        self.launchers.mkdir(parents=True, exist_ok=True)
        target = self.launchers / (identifier + '.desktop')
        with target.open('w') as stream:
            entry.write(stream, space_around_delimiters=False)
        return target.name

    def sync(self) -> None:
        self.require_ready()
        state = self.load()
        for name, record in state['packages'].items():
            installed, version = self.installed(name)
            record['status'] = 'installed' if installed else (
                'failed' if record.get('status') == 'failed' else 'not-installed')
            if installed:
                record['version'] = version
            old = set(record.get('launchers', []))
            new = set()
            if installed:
                files = self.execute(['dpkg-query', '-L', name], install=True, capture=True).stdout.splitlines()
                for file in files:
                    if file.startswith('/usr/share/applications/') and file.endswith('.desktop'):
                        launcher = self.export_desktop(name, file, files)
                        if launcher:
                            new.add(launcher)
            for stale in old - new:
                if Path(stale).name == stale and stale.startswith(self.desktop_prefix):
                    (self.launchers / stale).unlink(missing_ok=True)
                    for icon in self.icons.glob(Path(stale).stem + '.*'):
                        icon.unlink()
            record['launchers'] = sorted(new)
        atomic_json(self.manifest, state)
        if shutil.which('update-desktop-database') and self.launchers.exists():
            subprocess.run(['update-desktop-database', str(self.launchers)], check=False)

    def remove(self, package: str, simulate: bool) -> None:
        self.require_ready()
        if not PACKAGE_RE.fullmatch(package) or package not in self.load()['packages']:
            raise RuntimeError('Specify a package managed by agent-workspace-deb list.')
        self.apt(['--simulate' if simulate else '-y', 'remove', package])
        if not simulate:
            self.sync()

    def purge(self, package: str, simulate: bool, *, autoremove=False, user_config_paths=()) -> None:
        """Forget a managed package only after apt and filesystem cleanup succeed."""
        self.require_ready()
        state = self.load()
        if not PACKAGE_RE.fullmatch(package) or package not in state['packages']:
            raise RuntimeError('Specify a package managed by agent-workspace-deb list.')
        # Config ownership cannot be inferred from Debian package names. Require
        # explicit home-relative paths and reject traversal and symlink escapes.
        configs = []
        for value in user_config_paths:
            relative = Path(value)
            if relative.is_absolute() or '..' in relative.parts or len(relative.parts) < 2:
                raise RuntimeError('User config paths must be specific home-relative directories.')
            if relative.parts[0] not in ('.config', '.cache', '.local', '.vscode'):
                raise RuntimeError('User config paths must be under .config, .cache, .local or .vscode.')
            if relative.parts[0] == '.local' and len(relative.parts) < 3:
                raise RuntimeError('Specify an application directory within .local.')
            path = self.config / relative
            if path.is_symlink() or path.resolve() != path:
                raise RuntimeError(f'Refusing symlinked user config path: {path}')
            protected = (self.state, self.cache, self.launchers, self.icons,
                         self.config / '.config/agent-workspace',
                         self.config / '.local/share/code-server',
                         self.config / '.config/code-server')
            if any(path == item or path in item.parents or item in path.parents for item in protected):
                raise RuntimeError(f'Refusing shared runtime/config path: {path}')
            configs.append(path)
        # Match only archives named by this installer, including previous versions.
        pattern = re.compile(re.escape(package) + r'-[0-9a-f]{64}\.deb$')
        archives = [path for path in self.cache.glob('*.deb') if pattern.fullmatch(path.name)]
        log = self.config / '.local/log/agent-workspace' / self.app_log_directory / f'{package}.log'
        cleanup = [*archives, log, *configs]
        print(json.dumps({'purge': package, 'autoremove': autoremove,
                          'delete_paths': [str(path) for path in cleanup],
                          'keep_user_config': not bool(configs)}, indent=2), flush=True)
        args = ['--simulate' if simulate else '-y']
        if autoremove:
            args.append('--autoremove')
        self.apt([*args, 'purge', package])
        if simulate:
            return
        self.sync()
        if self.installed(package)[0]:
            raise RuntimeError('Package remains installed; keeping its manifest and cache.')
        for path in cleanup:
            if path.is_symlink() or path.is_file():
                path.unlink()
            elif path.is_dir():
                shutil.rmtree(path)
        if configs and self.overrides.exists():
            overrides = json.loads(self.overrides.read_text())
            overrides.pop(package, None)
            atomic_json(self.overrides, overrides)
        state = self.load()
        del state['packages'][package]
        atomic_json(self.manifest, state)

    def primary_launcher(self, package: str) -> Path:
        record = self.load()['packages'].get(package, {})
        for name in record.get('launchers', []):
            if Path(name).name != name or not name.startswith(self.desktop_prefix):
                continue
            path = self.launchers / name
            entry = desktop_config()
            entry.read(path)
            if 'Desktop Entry' not in entry:
                continue
            group = entry['Desktop Entry']
            if (group.get('Type') == 'Application' and group.get('Exec')
                    and group.get('NoDisplay', 'false').lower() != 'true'
                    and group.get('Hidden', 'false').lower() != 'true'):
                return path
        raise RuntimeError(f'No visible application launcher for {package}.')

    def launch(self, package: str) -> int:
        path = self.primary_launcher(package)
        if not (os.environ.get('DISPLAY') or os.environ.get('WAYLAND_DISPLAY')):
            raise RuntimeError('Launch this application from a desktop session.')
        command = (['kioclient', 'exec', str(path)] if shutil.which('kioclient') else
                   ['gio', 'launch', str(path)])
        return subprocess.run(command, check=False, start_new_session=True).returncode

    def electron_directory(self, executable: str, env: dict, cwd: str | None) -> Path | None:
        # Inspect the actual payload, not the deb filename or package name.
        # Resolve /usr/bin symlinks with guest semantics, including Code's bin wrapper.
        if '/' in executable:
            paths = [executable if executable.startswith('/') else str(Path(cwd or '/') / executable)]
        else:
            paths = [str(Path(p) / executable) for p in env.get('PATH', '').split(':') if p.startswith('/')]
        path = next((f for p in paths if (f := self.guest_file(p))), None)
        if not path or not os.access(path, os.X_OK):
            return None
        if any(word in path.name for word in ('crashpad', 'chrome-sandbox')):
            return None
        directories = [path.parent]
        if path.parent.name == 'bin':
            directories.append(path.parent.parent)
        for directory in directories:
            relative = '/' + str(directory.relative_to(self.root))
            if (all(self.guest_file(relative + '/' + name) for name in ('icudtl.dat', 'resources.pak'))
                    and any(self.guest_file(relative + '/' + name) for name in
                            ('resources/app.asar', 'resources/app/package.json'))):
                return directory
        return None

    def prepare_launch(self, argv: list[str], env: dict, package: str | None, cwd=None) -> tuple[list[str], dict]:
        argv = list(argv)
        report = {'profile': 'none', 'automatic_args': [], 'backend': 'proot' if self.proot_mode else 'native'}
        if not package:
            return argv, report
        if not PACKAGE_RE.fullmatch(package):
            raise RuntimeError('Invalid package name.')
        overrides = json.loads(self.overrides.read_text()) if self.overrides.exists() else {}
        if not isinstance(overrides, dict):
            raise RuntimeError('Application overrides must be a JSON object.')
        options = overrides.get(package, {})
        if not isinstance(options, dict):
            raise RuntimeError('Each application override must be a JSON object.')
        extra = options.get('extra_args', [])
        variables = options.get('environment', {})
        if not isinstance(extra, list) or not all(isinstance(v, str) for v in extra):
            raise RuntimeError('extra_args must be an array of strings.')
        if not isinstance(variables, dict) or not all(
                isinstance(k, str) and isinstance(v, str) for k, v in variables.items()):
            raise RuntimeError('environment must be an object of string values.')
        settings = options.get('compatibility', {})
        choices = {'profile': ('auto', 'electron', 'none'),
                   'display': ('auto', 'wayland', 'x11', 'default'),
                   'gpu': ('auto', 'software', 'default'),
                   'sandbox': ('auto', 'disabled', 'default')}
        if not isinstance(settings, dict) or any(
                k not in choices or v not in choices[k] for k, v in settings.items()):
            raise RuntimeError('Invalid compatibility setting; see persistent-deb-apps.md.')
        env.update(variables)
        effective_env = dict(env)
        index = 0
        if argv[0] in ('env', '/usr/bin/env', '/bin/env'):
            index = 1
            while index < len(argv):
                value = argv[index]
                if value == '--':
                    index += 1
                    continue
                if re.match(r'^[A-Za-z_][A-Za-z_0-9]*=', value):
                    key, value = value.split('=', 1)
                    effective_env[key] = value
                    index += 1
                else:
                    break
        if index >= len(argv) or argv[index].startswith('-'):
            if extra:
                raise RuntimeError('Use a direct executable or env NAME=value executable for application overrides.')
            return argv, report
        directory = self.electron_directory(argv[index], effective_env, cwd)
        profile = settings.get('profile', 'auto')
        electron = (profile == 'electron' or (profile == 'auto' and directory is not None)) and (
            effective_env.get('ELECTRON_RUN_AS_NODE') != '1')
        automatic = []
        if electron:
            report['profile'] = 'electron'
            if directory:
                report['application_directory'] = str(directory)
            # Explicit arguments win; operands after -- are never interpreted as switches.
            explicit = extra + argv[index + 1:]
            explicit = explicit[:explicit.index('--')] if '--' in explicit else explicit
            switches = {v.split('=', 1)[0] for v in explicit if v.startswith('--')}
            sandbox = settings.get('sandbox', 'auto')
            if (sandbox == 'disabled' or (sandbox == 'auto' and self.proot_mode)) and not (
                    switches & {'--no-sandbox', '--enable-sandbox'}):
                automatic.append('--no-sandbox')
            gpu = settings.get('gpu', 'auto')
            if (gpu == 'software' or (gpu == 'auto' and self.proot_mode)) and not (
                    switches & {'--disable-gpu', '--use-gl', '--use-angle', '--enable-gpu'}):
                automatic.append('--disable-gpu')
            display = settings.get('display', 'auto')
            wayland = effective_env.get('WAYLAND_DISPLAY', '')
            socket_path = Path(wayland) if wayland.startswith('/') else Path(
                effective_env.get('XDG_RUNTIME_DIR', '/nonexistent')) / wayland
            try:
                available = bool(wayland) and socket_path.is_socket()
            except OSError:
                available = False
            report['wayland_available'] = available
            if display == 'auto':
                display = 'wayland' if available else 'default'
            if display in ('wayland', 'x11') and not (
                    switches & {'--ozone-platform', '--ozone-platform-hint'}):
                automatic.append('--ozone-platform=' + display)
        # Insert after an optional env prefix and before file/URL operands.
        argv[index + 1:index + 1] = automatic + extra
        report['automatic_args'] = automatic
        application_args = argv[index + 1:]
        application_args = application_args[:application_args.index('--')] if '--' in application_args else application_args
        report['effective_switches'] = application_args
        return argv, report

    def stale_electron_processes(self, report: dict, proc_root=Path('/proc')) -> list[int]:
        directory = report.get('application_directory')
        if report['profile'] != 'electron' or not directory:
            return []
        switches = ('--no-sandbox', '--disable-gpu', '--ozone-platform=wayland', '--ozone-platform=x11')
        args = report.get('effective_switches', [])
        # Normalize both --ozone-platform=wayland and --ozone-platform wayland.
        def selected(arguments):
            arguments = list(arguments)
            for i, arg in enumerate(arguments[:-1]):
                if arg == '--ozone-platform':
                    arguments[i] = arg + '=' + arguments[i + 1]
            return set(arguments).intersection(switches)
        expected = selected(args)
        stale = []
        for process in proc_root.iterdir():
            if not process.name.isdigit():
                continue
            try:
                if process.stat().st_uid != os.getuid():
                    continue
                executable = (process / 'exe').readlink()
                if executable.parent != Path(directory) or any(
                        part in executable.name for part in ('crashpad', 'chrome-sandbox')):
                    continue
                running = (process / 'cmdline').read_bytes().decode(errors='replace').split('\0')
                if any(arg.startswith('--type=') for arg in running):
                    continue
                if b'ELECTRON_RUN_AS_NODE=1' in (process / 'environ').read_bytes().split(b'\0'):
                    continue
                if selected(running) != expected:
                    stale.append(int(process.name))
            except OSError:
                continue
        return stale

    def run(self, argv: list[str], cwd: str | None, package: str | None = None, desktop=False, dry_run=False) -> int:
        argv = list(argv)
        self.require_ready()
        if argv and argv[0] == '--':
            argv = argv[1:]
        if not argv:
            raise RuntimeError('Specify an application command after run --.')
        if cwd and not cwd.startswith('/'):
            raise RuntimeError('--cwd must be an absolute guest path.')
        env = self.environment(False)
        argv, compatibility = self.prepare_launch(argv, env, package, cwd)
        if dry_run:
            print(json.dumps({'argv': argv, 'compatibility': compatibility}, ensure_ascii=False, indent=2))
            return 0
        application_log = self.log.parent / self.app_log_directory / ((package or 'application') + '.log')
        with contextlib.ExitStack() as stack:
            stack.enter_context(self.app_lock(shared=True))
            stack.enter_context(self.open_bridge(env))
            output = None
            if desktop:
                application_log.parent.mkdir(parents=True, exist_ok=True)
                output = stack.enter_context(application_log.open('a', buffering=1))
                print(time.strftime('[%Y-%m-%dT%H:%M:%S%z]'),
                      'launch', json.dumps(argv, ensure_ascii=False), file=output)
                print('compatibility', json.dumps(compatibility), file=output)
                stale = self.stale_electron_processes(compatibility)
                if stale:
                    message = (f'{package}: 检测到仍使用旧启动参数的进程 {stale}。'
                               '请保存工作，使用应用的“退出”或 Ctrl+Q 完全退出，再重新打开。\n'
                               'An existing process has different launch settings. Save your work, '
                               'Quit the application completely, then reopen it.')
                    print(message, file=output)
                    notification = None
                    if shutil.which('kdialog'):
                        notification = ['kdialog', '--title', 'Application restart needed', '--passivepopup', message, '12']
                    elif shutil.which('notify-send'):
                        notification = ['notify-send', 'Application restart needed', message]
                    if notification:
                        process = subprocess.Popen(notification, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                        threading.Thread(target=process.wait, daemon=True).start()
            startup_failure = ''
            if desktop:
                started = time.monotonic()
                with subprocess.Popen(self.invocation(argv, cwd=cwd), env=env,
                                      stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                                      text=True, errors='replace') as process:
                    for line in iter(lambda: process.stdout.readline(8192), ''):
                        output.write(line)
                        if time.monotonic() - started < 30:
                            if (('zygote_linux.cc' in line and 'Broken pipe' in line)
                                    or 'No usable sandbox!' in line
                                    or 'Running as root without --no-sandbox' in line):
                                startup_failure = ('Chromium sandbox startup failed. This application needs '
                                                   'a per-app compatibility setting or Native installation.')
                    code = process.wait()
                if time.monotonic() - started >= 30:
                    startup_failure = ''
            else:
                code = subprocess.run(self.invocation(argv, cwd=cwd), env=env, check=False).returncode
            if output:
                print(time.strftime('[%Y-%m-%dT%H:%M:%S%z]'), f'exit={code}', file=output)
                if startup_failure:
                    print('Startup failure:', startup_failure, file=output)
                    code = code or 1
        if code and desktop:
            message = ((startup_failure or f'{package or argv[0]} exited with status {code}.')
                       + f'\n\nLog: {application_log}')
            dialog = None
            if shutil.which('kdialog'):
                dialog = ['kdialog', '--title', 'Application launch failed', '--error',
                          '<qt>' + html.escape(message).replace('\n', '<br/>') + '</qt>']
            elif shutil.which('zenity'):
                dialog = ['zenity', '--error', '--no-markup',
                          '--title=Application launch failed', '--text', message]
            if dialog:
                process = subprocess.Popen(dialog, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                threading.Thread(target=process.wait, daemon=True).start()
        return code

    def backup(self) -> None:
        self.require_ready()
        directory = self.config / '.cache/agent-workspace/deb-backups'
        directory.mkdir(parents=True, exist_ok=True)
        destination = directory / ('deb-runtime-' + time.strftime('%Y%m%d-%H%M%S') + '.tar.gz')
        temporary = destination.with_suffix('.part')
        subprocess.run(['tar', '-czf', str(temporary), '-C', str(self.state),
                        'rootfs', 'ready.json', *(['packages.json'] if self.manifest.exists() else [])], check=True)
        temporary.replace(destination)
        print(destination)

    def restore(self, archive: Path) -> None:
        """Restore a trusted backup, retaining the previous environment for recovery."""
        if not archive.is_file():
            raise RuntimeError('Backup archive does not exist.')

        def archive_filter(member, destination):
            # A backup may contain absolute guest symlinks. Make them relative to
            # the staged rootfs before applying Python's traversal/special-file checks.
            parts = Path(member.name).parts
            if not parts or parts[0] not in ('rootfs', 'ready.json', 'packages.json'):
                raise RuntimeError('Unexpected entry in Debian runtime backup.')
            if member.issym() and member.linkname.startswith('/'):
                if parts[0] != 'rootfs':
                    raise RuntimeError('Unexpected metadata symlink in backup.')
                member = member.replace(linkname=os.path.relpath(
                    'rootfs/' + member.linkname.lstrip('/'), str(Path(member.name).parent)))
            return tarfile.data_filter(member, destination)

        with tempfile.TemporaryDirectory(prefix='.restore-', dir=self.state) as directory:
            staging = Path(directory)
            with tarfile.open(archive) as bundle:
                bundle.extractall(staging, filter=archive_filter)
            ready = json.loads((staging / 'ready.json').read_text())
            if ready.get('release') != '24.04' or ready.get('arch') != self.arch:
                raise RuntimeError('Backup distribution or architecture does not match this runtime.')
            if not (staging / 'rootfs/usr/bin/apt-get').is_file():
                raise RuntimeError('Backup does not contain a usable rootfs.')
            incoming = staging / 'packages.json'
            restored = json.loads(incoming.read_text()) if incoming.exists() else {'schema': 1, 'packages': {}}
            if not isinstance(restored.get('packages'), dict) or not all(
                    PACKAGE_RE.fullmatch(name) and isinstance(record, dict)
                    for name, record in restored['packages'].items()):
                raise RuntimeError('Invalid package manifest in backup.')
            old = self.load()
            # Merge previous launcher names so sync can remove obsolete host entries.
            for name, record in old['packages'].items():
                target = restored['packages'].setdefault(name, record.copy())
                target['launchers'] = sorted(set(target.get('launchers', [])) | set(record.get('launchers', [])))
            previous = self.config / '.cache/agent-workspace/deb-backups' / ('previous-' + uuid.uuid4().hex[:12])
            previous.mkdir(parents=True)
            for name in ('ready.json', 'packages.json'):
                if (self.state / name).exists():
                    shutil.copyfile(self.state / name, previous / name)
            if self.root.exists():
                self.root.rename(previous / 'rootfs')
            try:
                (staging / 'rootfs').rename(self.root)
                atomic_json(self.state / 'ready.json', ready)
                atomic_json(self.manifest, restored)
                self.install_open_shim()
                self.sync()
            except BaseException:
                if self.root.exists():
                    self.root.rename(previous / 'failed-restoration')
                if (previous / 'rootfs').exists():
                    (previous / 'rootfs').rename(self.root)
                for name in ('ready.json', 'packages.json'):
                    if (previous / name).exists():
                        shutil.copyfile(previous / name, self.state / name)
                    else:
                        (self.state / name).unlink(missing_ok=True)
                raise
            print(f'Restored {archive}; previous environment retained at {previous}')


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest='action', required=True)
    for name in ('init', 'status', 'list', 'sync', 'backup'):
        commands.add_parser(name)
    for name in ('launch', 'launcher'):
        commands.add_parser(name).add_argument('package')
    for name in ('install', 'remove', 'purge'):
        command = commands.add_parser(name)
        command.add_argument('package')
        command.add_argument('--yes', action='store_true')
        command.add_argument('--dry-run', action='store_true')
        if name == 'purge':
            command.add_argument('--autoremove', action='store_true', help='Also purge unused dependencies')
            config_choice = command.add_mutually_exclusive_group()
            config_choice.add_argument('--keep-user-config', action='store_true', help='Keep user configuration (default)')
            config_choice.add_argument('--delete-user-config', action='store_true', help='Delete explicit --user-config-path directories')
            command.add_argument('--user-config-path', action='append', default=[], help='Home-relative application directory; repeatable')
    for name in ('upgrade', 'repair'):
        command = commands.add_parser(name)
        command.add_argument('--yes', action='store_true')
    restore = commands.add_parser('restore')
    restore.add_argument('archive', type=Path)
    restore.add_argument('--yes', action='store_true')
    run = commands.add_parser('run')
    run.add_argument('--cwd')
    run.add_argument('--package')
    run.add_argument('--desktop', action='store_true')
    run.add_argument('--dry-run', action='store_true', help='Print effective launch arguments without starting the app')
    run.add_argument('command', nargs=argparse.REMAINDER)
    args = parser.parse_args()
    if args.action == 'purge' and bool(args.user_config_path) != args.delete_user_config:
        parser.error('--delete-user-config requires --user-config-path, and vice versa.')
    runtime = Runtime()
    if args.action == 'run':
        return runtime.run(args.command, args.cwd, args.package, args.desktop, args.dry_run)
    if args.action == 'launcher':
        print(runtime.primary_launcher(args.package))
        return 0
    if args.action == 'launch':
        return runtime.launch(args.package)
    if args.action in ('status', 'list'):
        print(json.dumps({'rootfs': str(runtime.root), 'ready': (runtime.state / 'ready.json').exists(),
                          **runtime.load()}, ensure_ascii=False, indent=2))
        return 0
    if args.action in ('install', 'remove', 'purge', 'upgrade', 'repair', 'restore'):
        if not args.yes and not getattr(args, 'dry_run', False):
            parser.error('Inspect the operation first; pass --yes to apply it.')
    with runtime.lock(exclusive_apps=args.action in ('init', 'backup', 'restore')):
        if args.action == 'init':
            runtime.init()
        elif args.action == 'install':
            runtime.install(Path(args.package).resolve(), args.dry_run)
        elif args.action == 'remove':
            runtime.remove(args.package, args.dry_run)
        elif args.action == 'purge':
            runtime.purge(args.package, args.dry_run, autoremove=args.autoremove,
                          user_config_paths=args.user_config_path)
        elif args.action == 'sync':
            runtime.sync()
        elif args.action == 'backup':
            runtime.backup()
        elif args.action == 'restore':
            runtime.restore(args.archive)
        else:
            runtime.require_ready()
            runtime.apt(['update'])
            if args.action == 'repair':
                runtime.apt(['--fix-broken', '--no-remove', 'install', '-y'])
                runtime.execute(['dpkg', '--configure', '-a'], install=True)
            else:
                runtime.apt(['upgrade', '--no-remove', '-y'])
            runtime.sync()
    return 0


if __name__ == '__main__':
    try:
        sys.exit(main())
    except (RuntimeError, OSError, ValueError, subprocess.CalledProcessError, configparser.Error, tarfile.TarError) as error:
        print(f'Persistent Debian environment: {error}', file=sys.stderr)
        sys.exit(1)
    except KeyboardInterrupt:
        sys.exit(130)
