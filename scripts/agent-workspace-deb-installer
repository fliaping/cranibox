#!/usr/bin/env bash
set -uo pipefail

CONFIG_ROOT="${AGENT_WORKSPACE_CONFIG_ROOT:-/config}"
LOG_DIR="${CONFIG_ROOT}/.local/log/agent-workspace"
LOG_FILE="${LOG_DIR}/deb-installer.log"
DRY_RUN=false
ASSUME_YES=false
PACKAGE_FILE=""
DEB_BACKEND="${CONFIG_ROOT}/bin/agent-workspace-deb"
DIALOG_BACKEND=""
INSTALL_MODE=""
if [[ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]]; then
  if command -v kdialog >/dev/null 2>&1 && [[ "${XDG_CURRENT_DESKTOP:-}" == *KDE* || -n "${WAYLAND_DISPLAY:-}" ]]; then
    DIALOG_BACKEND=kdialog
  elif command -v zenity >/dev/null 2>&1; then
    DIALOG_BACKEND=zenity
  elif command -v kdialog >/dev/null 2>&1; then
    DIALOG_BACKEND=kdialog
  elif [[ -n "${DISPLAY:-}" ]] && command -v xmessage >/dev/null 2>&1; then
    DIALOG_BACKEND=xmessage
  fi
fi

INTERFACE_LOCALE="${LC_ALL:-${LANG:-en}}"
if [[ "${INTERFACE_LOCALE,,}" == zh* ]]; then
  APP_TITLE="Cranibox 软件包安装器"
  QUESTION_TEXT="将这个软件包安装到持久化应用环境吗？"
  TRUST_WARNING="应用和依赖将保存在 /config，容器重建后保留。首次安装需要下载 Ubuntu 环境。识别到 Electron 应用后，会默认关闭该应用的 Chromium 沙箱并使用软件渲染以兼容 PRoot，可在应用配置中覆盖。请只安装可信软件包；应用可以访问你的文件。"
  INSTALL_LABEL="安装"
  CANCEL_LABEL="取消"
  CONTINUE_PROMPT="是否继续？[y/N]"
  CONFIRM_UNAVAILABLE="无法显示交互式确认。检查软件包后，请使用 --yes 重新运行。"
  ONE_PACKAGE_ERROR="每次只能安装一个 .deb 软件包。"
  CHOOSE_PACKAGE_ERROR="请选择要安装的 .deb 软件包。"
  READABLE_PACKAGE_ERROR="所选文件不是可读取的 .deb 软件包。"
  VALID_PACKAGE_ERROR="所选文件不是有效的 Debian 软件包。"
  BACKEND_ERROR="持久化安装后端不可用。请运行 agent-workspace-manager install deb-runtime。"
  BUSY_ERROR="另一个软件包安装任务正在运行。"
  PACKAGE_LABEL="软件包"
  VERSION_LABEL="版本"
  ARCH_LABEL="架构"
  FILE_LABEL="文件"
  NO_DESCRIPTION="没有软件包说明"
  INSTALLING_LABEL="正在安装"
  SUCCESS_SUFFIX="安装成功。"
  LOG_LABEL="日志"
  FAILED_LABEL="安装失败"
  ERROR_LABEL="错误"
else
  APP_TITLE="Cranibox Software Installer"
  QUESTION_TEXT="Install this package in the persistent application environment?"
  TRUST_WARNING="Applications and dependencies stay under /config across container rebuilds. First use downloads Ubuntu. Detected Electron apps default to a disabled Chromium sandbox and software rendering for PRoot compatibility; per-app settings can override this. Install only trusted packages; applications can access your files."
  INSTALL_LABEL="Install"
  CANCEL_LABEL="Cancel"
  CONTINUE_PROMPT="Continue? [y/N]"
  CONFIRM_UNAVAILABLE="Interactive confirmation is unavailable. Re-run with --yes after inspecting the package."
  ONE_PACKAGE_ERROR="Install one .deb package at a time."
  CHOOSE_PACKAGE_ERROR="Choose a .deb package to install."
  READABLE_PACKAGE_ERROR="The selected file is not a readable .deb package."
  VALID_PACKAGE_ERROR="The selected file is not a valid Debian package."
  BACKEND_ERROR="Persistent installer backend is unavailable. Run agent-workspace-manager install deb-runtime."
  BUSY_ERROR="Another software package installation is already running."
  PACKAGE_LABEL="Package"
  VERSION_LABEL="Version"
  ARCH_LABEL="Architecture"
  FILE_LABEL="File"
  NO_DESCRIPTION="No description"
  INSTALLING_LABEL="Installing"
  SUCCESS_SUFFIX="was installed successfully."
  LOG_LABEL="Log"
  FAILED_LABEL="Installation failed"
  ERROR_LABEL="Error"
fi

usage() {
  cat <<'EOF'
Usage: agent-workspace-deb-installer [--native|--proot] [--dry-run] [--yes] <package.deb>

Open a Debian package from the desktop, inspect its metadata, resolve
dependencies inside persistent Ubuntu, and keep applications and logs under /config.
Use agent-workspace-deb for status, removal, updates and backups.
EOF
}

show_error() {
  local message="$1"
  printf '%s: %s\n' "$ERROR_LABEL" "$message" >&2
  if $ASSUME_YES; then
    return
  elif [[ "$DIALOG_BACKEND" == kdialog ]]; then
    kdialog --title "$APP_TITLE" --error "$(qt_text "$message")" || true
  elif [[ "$DIALOG_BACKEND" == zenity ]]; then
    zenity --error --no-markup --title="$APP_TITLE" --width=480 --text="$message" || true
  elif [[ "$DIALOG_BACKEND" == xmessage ]]; then
    xmessage -center -title "$APP_TITLE" "$message" || true
  fi
}

show_info() {
  local message="$1"
  if $ASSUME_YES; then
    printf '%s\n' "$message"
  elif [[ "$DIALOG_BACKEND" == kdialog ]]; then
    kdialog --title "$APP_TITLE" --msgbox "$(qt_text "$message")" || true
  elif [[ "$DIALOG_BACKEND" == zenity ]]; then
    zenity --info --no-markup --title="$APP_TITLE" --width=480 --text="$message" || true
  elif [[ "$DIALOG_BACKEND" == xmessage ]]; then
    xmessage -center -title "$APP_TITLE" "$message" || true
  else
    printf '%s\n' "$message"
  fi
}

confirm_install() {
  local details="$1" prompt=""
  if $ASSUME_YES; then
    return 0
  fi
  if [[ "$DIALOG_BACKEND" == kdialog ]]; then
    printf -v prompt '%s\n\n%s\n\n%s' "$QUESTION_TEXT" "$details" "$TRUST_WARNING"
    kdialog --title "$APP_TITLE" --yes-label "$INSTALL_LABEL" --no-label "$CANCEL_LABEL" \
      --yesno "$(qt_text "$prompt")"
    return $?
  fi
  if [[ "$DIALOG_BACKEND" == zenity ]]; then
    printf -v prompt '%s\n\n%s\n\n%s' "$QUESTION_TEXT" "$details" "$TRUST_WARNING"
    zenity --question \
      --no-markup \
      --title="$APP_TITLE" \
      --width=680 \
      --ok-label="$INSTALL_LABEL" \
      --cancel-label="$CANCEL_LABEL" \
      --text="$prompt"
    return $?
  fi
  if [[ "$DIALOG_BACKEND" == xmessage ]]; then
    printf -v prompt '%s\n\n%s\n\n%s' "$QUESTION_TEXT" "$details" "$TRUST_WARNING"
    xmessage -center -title "$APP_TITLE" -buttons "$INSTALL_LABEL:0,$CANCEL_LABEL:1" "$prompt"
    return $?
  fi
  if [[ -t 0 ]]; then
    printf '%s\n\n%s %s ' "$details" "$TRUST_WARNING" "$CONTINUE_PROMPT"
    read -r answer
    [[ "$answer" =~ ^[Yy]$ ]]
    return
  fi
  show_error "$CONFIRM_UNAVAILABLE"
  return 1
}

run_install() {
  local package="$1" temporary="$2"
  "$DEB_BACKEND" install --yes "$package" >"$temporary" 2>&1
}

qt_text() {
  # KDialog auto-detects rich text. Escape package-provided text explicitly.
  local value="$1"
  value="${value//&/\&amp;}"
  value="${value//</\&lt;}"
  value="${value//>/\&gt;}"
  value="${value//$'\n'/<br/>}"
  printf '<qt>%s</qt>' "$value"
}

show_kde_progress() {
  local bus="" reference="" service="" object="" line="" previous=""
  bus="$(command -v qdbus6 || command -v qdbus || true)"
  if [[ -z "$bus" ]]; then
    kdialog --title "$APP_TITLE" --passivepopup "$INSTALLING_LABEL ${PACKAGE_NAME:-package}…" 5 || true
    return
  fi
  reference="$(kdialog --title "$APP_TITLE" --progressbar "$INSTALLING_LABEL ${PACKAGE_NAME:-package}…" 0)" || return
  read -r service object <<<"$reference"
  [[ -n "$service" && -n "$object" ]] || return
  "$bus" "$service" "$object" showCancelButton false >/dev/null 2>&1 || true
  while kill -0 "$INSTALL_PID" 2>/dev/null; do
    line="$(tail -n 1 "$TEMPORARY_LOG" 2>/dev/null || true)"
    if [[ -n "$line" && "$line" != "$previous" ]]; then
      "$bus" "$service" "$object" setLabelText "$(qt_text "$line")" >/dev/null 2>&1 || break
      previous="$line"
    fi
    sleep 0.5
  done
  "$bus" "$service" "$object" close >/dev/null 2>&1 || true
}

for argument in "$@"; do
  case "$argument" in
    --dry-run) DRY_RUN=true ;;
    --yes|-y) ASSUME_YES=true ;;
    --native) INSTALL_MODE=native ;;
    --proot) INSTALL_MODE=proot ;;
    --help|-h) usage; exit 0 ;;
    --*) show_error "$ERROR_LABEL: $argument"; exit 2 ;;
    *)
      if [[ -n "$PACKAGE_FILE" ]]; then
        show_error "$ONE_PACKAGE_ERROR"
        exit 2
      fi
      PACKAGE_FILE="$argument"
      ;;
  esac
done

if ! $ASSUME_YES && ! $DRY_RUN && [[ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]]; then
  mkdir -p "$LOG_DIR"
  exec 2>>"${LOG_DIR}/deb-installer-launch.log"
  printf '[%s] launch file=%q desktop=%q display=%q wayland=%q dialog=%q\n' \
    "$(date -u +'%Y-%m-%dT%H:%M:%SZ')" "$PACKAGE_FILE" "${XDG_CURRENT_DESKTOP:-}" \
    "${DISPLAY:-}" "${WAYLAND_DISPLAY:-}" "$DIALOG_BACKEND" >&2
fi

if [[ -z "$PACKAGE_FILE" ]]; then
  show_error "$CHOOSE_PACKAGE_ERROR"
  exit 2
fi

PACKAGE_FILE="$(realpath -- "$PACKAGE_FILE" 2>/dev/null || true)"
if [[ -z "$PACKAGE_FILE" || ! -f "$PACKAGE_FILE" || "$PACKAGE_FILE" != *.deb ]]; then
  show_error "$READABLE_PACKAGE_ERROR"
  exit 2
fi
if ! dpkg-deb --info "$PACKAGE_FILE" >/dev/null 2>&1; then
  show_error "$VALID_PACKAGE_ERROR"
  exit 2
fi

PACKAGE_NAME="$(dpkg-deb --field "$PACKAGE_FILE" Package 2>/dev/null || true)"
PACKAGE_VERSION="$(dpkg-deb --field "$PACKAGE_FILE" Version 2>/dev/null || true)"
PACKAGE_ARCH="$(dpkg-deb --field "$PACKAGE_FILE" Architecture 2>/dev/null || true)"
PACKAGE_DESCRIPTION="$(dpkg-deb --field "$PACKAGE_FILE" Description 2>/dev/null | head -n 1 || true)"
printf -v DETAILS '%s: %s\n%s: %s\n%s: %s\n%s\n\n%s: %s' \
  "$PACKAGE_LABEL" "${PACKAGE_NAME:-unknown}" "$VERSION_LABEL" "${PACKAGE_VERSION:-unknown}" \
  "$ARCH_LABEL" "${PACKAGE_ARCH:-unknown}" \
  "${PACKAGE_DESCRIPTION:-$NO_DESCRIPTION}" "$FILE_LABEL" "$PACKAGE_FILE"

if [[ "${INTERFACE_LOCALE,,}" == zh* ]]; then
  MODE_PROMPT="选择安装方式"
  PROOT_LABEL="PRoot：应用和依赖直接保存在 /config"
  NATIVE_LABEL="原生：正常安装到系统，保存安装包，启动时恢复"
  NATIVE_WARNING="软件将以管理员权限安装到系统目录；安装包和恢复清单保存在 /config。容器重建后自动重装，依赖可能需要联网下载。只安装可信软件包。"
  LAUNCH_LABEL="启动应用"
  CLOSE_LABEL="关闭"
else
  MODE_PROMPT="Choose installation mode"
  PROOT_LABEL="PRoot: keep applications and dependencies under /config"
  NATIVE_LABEL="Native: install into the system and restore saved packages at startup"
  NATIVE_WARNING="Installs into system directories with administrator privileges. Archives and the replay manifest stay under /config. Rebuilds reinstall saved packages; dependencies may need network access. Install only trusted packages."
  LAUNCH_LABEL="Launch application"
  CLOSE_LABEL="Close"
fi
if [[ -z "$INSTALL_MODE" ]] && ! $ASSUME_YES && ! $DRY_RUN; then
  case "$DIALOG_BACKEND" in
    kdialog) INSTALL_MODE="$(kdialog --title "$APP_TITLE" --radiolist "$MODE_PROMPT" proot "$PROOT_LABEL" on native "$NATIVE_LABEL" off)" || exit 0 ;;
    zenity) INSTALL_MODE="$(zenity --list --radiolist --title="$APP_TITLE" --text="$MODE_PROMPT" --column="" --column=Mode --column=Description --hide-column=2 --print-column=2 TRUE proot "$PROOT_LABEL" FALSE native "$NATIVE_LABEL")" || exit 0 ;;
    xmessage)
      xmessage -center -title "$APP_TITLE" -buttons 'PRoot:10,Native:11,Cancel:12' "$PROOT_LABEL
$NATIVE_LABEL"
      case $? in 10) INSTALL_MODE=proot ;; 11) INSTALL_MODE=native ;; *) exit 0 ;; esac ;;
  esac
fi
INSTALL_MODE="${INSTALL_MODE:-proot}"
case "$INSTALL_MODE" in
  native)
    DEB_BACKEND="${CONFIG_ROOT}/bin/agent-workspace-deb-native"
    LOG_FILE="${LOG_DIR}/deb-installer-native.log"
    QUESTION_TEXT="$NATIVE_LABEL"
    TRUST_WARNING="$NATIVE_WARNING" ;;
  proot) ;;
  *) show_error "Invalid installation mode: $INSTALL_MODE"; exit 2 ;;
esac

if [[ ! -x "$DEB_BACKEND" ]]; then
  show_error "$BACKEND_ERROR"
  exit 127
fi

if $DRY_RUN; then
  exec "$DEB_BACKEND" install --dry-run "$PACKAGE_FILE"
fi

if ! confirm_install "$DETAILS"; then
  exit 0
fi

mkdir -p "$LOG_DIR"
RUNTIME_DIR="${CONFIG_ROOT}/.local/run/agent-workspace"
mkdir -p "$RUNTIME_DIR"
exec 9>"${RUNTIME_DIR}/deb-installer.lock"
if ! flock -n 9; then
  show_error "$BUSY_ERROR"
  exit 75
fi
TEMPORARY_LOG="$(mktemp "${TMPDIR:-/tmp}/agent-workspace-deb.XXXXXX.log")"
trap 'rm -f -- "$TEMPORARY_LOG"' EXIT
STARTED_AT="$(date -u +'%Y-%m-%dT%H:%M:%SZ')"

run_install "$PACKAGE_FILE" "$TEMPORARY_LOG" &
INSTALL_PID=$!

if ! $ASSUME_YES && [[ "$DIALOG_BACKEND" == kdialog ]]; then
  show_kde_progress
elif ! $ASSUME_YES && [[ "$DIALOG_BACKEND" == zenity ]]; then
  (
    LAST_LINE=""
    while kill -0 "$INSTALL_PID" 2>/dev/null; do
      CURRENT_LINE="$(tail -n 1 "$TEMPORARY_LOG" 2>/dev/null || true)"
      if [[ -n "$CURRENT_LINE" && "$CURRENT_LINE" != "$LAST_LINE" ]]; then
        CURRENT_LINE="${CURRENT_LINE//&/&amp;}"
        CURRENT_LINE="${CURRENT_LINE//</&lt;}"
        CURRENT_LINE="${CURRENT_LINE//>/&gt;}"
        printf '# %s\n' "$CURRENT_LINE"
        LAST_LINE="$CURRENT_LINE"
      fi
      sleep 0.35
    done
  ) | zenity --progress --pulsate --no-cancel --auto-close \
      --title="$APP_TITLE" --width=560 --text="$INSTALLING_LABEL ${PACKAGE_NAME:-package}…" || true
fi

wait "$INSTALL_PID"
INSTALL_STATUS=$?
{
  printf '\n[%s] %s %s (%s)\n' "$STARTED_AT" "${PACKAGE_NAME:-unknown}" "${PACKAGE_VERSION:-unknown}" "$PACKAGE_FILE"
  cat "$TEMPORARY_LOG"
  printf '[exit=%s]\n' "$INSTALL_STATUS"
} >>"$LOG_FILE"
flock -u 9

if [[ "$INSTALL_STATUS" -eq 0 ]]; then
  printf -v RESULT_MESSAGE '%s %s %s\n\n%s: %s' "${PACKAGE_NAME:-package}" "${PACKAGE_VERSION:-}" "$SUCCESS_SUFFIX" "$LOG_LABEL" "$LOG_FILE"
  if ! $ASSUME_YES && "$DEB_BACKEND" launcher "$PACKAGE_NAME" >/dev/null 2>&1; then
    LAUNCH_NOW=false
    case "$DIALOG_BACKEND" in
      kdialog) kdialog --title "$APP_TITLE" --yes-label "$LAUNCH_LABEL" --no-label "$CLOSE_LABEL" --yesno "$(qt_text "$RESULT_MESSAGE")" && LAUNCH_NOW=true ;;
      zenity) zenity --question --no-markup --title="$APP_TITLE" --ok-label="$LAUNCH_LABEL" --cancel-label="$CLOSE_LABEL" --text="$RESULT_MESSAGE" && LAUNCH_NOW=true ;;
      *) show_info "$RESULT_MESSAGE" ;;
    esac
    if $LAUNCH_NOW; then
      "$DEB_BACKEND" launch "$PACKAGE_NAME" >>"$LOG_FILE" 2>&1 || show_error "Launch failed. $LOG_LABEL: $LOG_FILE"
    fi
  else
    show_info "$RESULT_MESSAGE"
  fi
  exit 0
fi

ERROR_DETAILS="$(awk '
  /^(malloc\(\)|free\(\)|dpkg(-deb)?: error|E: |fatal:|error:)/ { remaining = 3 }
  remaining > 0 && shown < 12 { print; remaining--; shown++ }
' "$TEMPORARY_LOG")"
if [[ -z "$ERROR_DETAILS" ]]; then
  ERROR_DETAILS="$(tail -n 5 "$TEMPORARY_LOG")"
fi
printf -v RESULT_MESSAGE '%s (exit %s)\n\n%s\n\n%s: %s' "$FAILED_LABEL" "$INSTALL_STATUS" \
  "$ERROR_DETAILS" "$LOG_LABEL" "$LOG_FILE"
show_error "$RESULT_MESSAGE"
exit "$INSTALL_STATUS"
